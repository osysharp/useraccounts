  title "Phone" => "Telefon";
  /// AccountSettings · a title
  /// shown through SettingsSection.title
  title "Sign in with" => "Logga in med";
  /// AccountSettings · a title
  /// shown through SettingsSection.title
  /// beside: "Address", "Password", "Passkeys"
