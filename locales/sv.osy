  /// AccountSettings · message
  /// placeholders: {facts.AppName} = facts.AppName (string)
  /// shown through Alert.message
  message "{facts.AppName} asks for two-step sign-in on your account." => "{facts.AppName} kräver tvåstegsinloggning på ditt konto.";
  /// AccountSettings · note
  /// placeholders: {address.Email} = address.Email (string)
  /// shown through note
  note "A new link to confirm {address.Email} is on its way." => "En ny länk för att bekräfta {address.Email} är på väg.";
  /// AccountSettings · placeholder text inside an empty field · at most ~34 characters
  /// shown through Field.placeholder
  placeholder "MacBook, iPhone, YubiKey" => "MacBook, iPhone, YubiKey";
  /// AccountSettings · text on the page
  /// placeholders: {address.Pending} = address.Pending (string)
  /// beside: "Your account moves to it when the link in that mail is opened.", "Resend"
  text "Confirmation sent to {address.Pending}" => "Bekräftelse skickad till {address.Pending}";
  /// AccountSettings · text on the page
  /// beside: "Off"
  text "Lost every device with a passkey? \"Forgot your password?\" on the sign-in page mails you a link that sets one again." => "Har du tappat bort alla enheter med en nyckel? \"Glömt lösenordet?\" på inloggningssidan mejlar dig en länk som sätter ett nytt.";
  /// AccountSettings · text on the page
  text "No number" => "Inget nummer";
  /// AccountSettings · text on the page
  text "No passkeys yet." => "Inga nycklar än.";
  /// AccountSettings · text on the page
  text "Signing in asks for a code texted to this number." => "Inloggningen kräver en kod via sms till det här numret.";
  /// AccountSettings · text on the page
  text "This browser cannot make passkeys." => "Den här webbläsaren kan inte skapa nycklar.";
  /// AccountSettings · text on the page
  /// shown through problem
  text "Type the address to move to." => "Skriv adressen du vill flytta till.";
  /// AccountSettings · text on the page
  /// shown through problem
  text "Type the new password." => "Skriv det nya lösenordet.";
  /// AccountSettings · text on the page
  /// shown through problem
  text "Type the number." => "Skriv numret.";
  /// AccountSettings · text on the page
  text "We texted a code to your number." => "Vi har skickat en kod via sms till ditt nummer.";
  /// AccountSettings · text on the page
  /// placeholders: {newPhone} = newPhone (string)
  text "We texted a code to {newPhone}." => "Vi har skickat en kod via sms till {newPhone}.";
  /// AccountSettings · text on the page
  /// beside: "Off"
  text "You sign in with your passkeys." => "Du loggar in med dina nycklar.";
  /// AccountSettings · text on the page
  /// beside: "Resend"
  text "Your account moves to it when the link in that mail is opened." => "Ditt konto flyttas dit när länken i det mejlet öppnas.";
  /// AccountSettings · text on the page
  /// placeholders: {twoStep.RecoveryCodesLeft} = twoStep.RecoveryCodesLeft (int) — {twoStep.RecoveryCodesLeft} is a count: give one text per plural form
  text "{twoStep.RecoveryCodesLeft} recovery codes left" => { one: "{twoStep.RecoveryCodesLeft} reservkod kvar", other: "{twoStep.RecoveryCodesLeft} reservkoder kvar" };
  /// AccountSettings · a title
  /// shown through SettingsSection.title
  /// beside: "Password", "Passkeys", "Two-step sign-in"
  title "Address" => "Adress";
  /// AccountSettings · a title
  /// shown through SettingsSection.title
