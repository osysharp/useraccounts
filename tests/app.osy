// The producer's test project for Osysharp.UserAccounts — an app that signs its people in with the kit and writes nothing
// of its own about it but its roles, one setting, and a type of its own derived from `User` (`Employee`).
app AccountsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  // One-time codes by text: a recording sender (tests/model/app.osy) — no test ever sends a real message.
  use Osysharp.Sms@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.EmailTemplates@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
  use Osysharp.Storage;
  // Provider sign-in: `app.OAuthClients` below.
  use Osysharp.Oauth;
}

