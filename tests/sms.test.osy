// A phone number on an account — proven by a texted code, then a way to sign in with a texted code, or an account's own
// choice of second step — and never the second factor an app can REQUIRE. Every text goes through
// the desk's recording sender: no test sends a real message.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Sms;

[TestFixture]
void Phones() {
  new User { Email = "ada@desk.test", DisplayName = "Ada", PasswordHash = Security.HashPassword("correct-horse-1"),
             EmailVerifiedAt = DateTime.UtcNow };
  new User { Email = "bo@desk.test", DisplayName = "Bo", PasswordHash = Security.HashPassword("correct-horse-2"),
             EmailVerifiedAt = DateTime.UtcNow, Phone = "+46700000002", PhoneVerifiedAt = DateTime.UtcNow };
  // An admin — the desk REQUIRES a second factor of admins (AdminsUseCodes) — with a proven phone.
  var root = new User { Email = "root@desk.test", DisplayName = "Root", PasswordHash = Security.HashPassword("correct-horse-3"),
                        EmailVerifiedAt = DateTime.UtcNow, Phone = "+46700000003", PhoneVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = root, Role = AppRole.Admin };
}

principal Ada => User.Single(u => u.Email == "ada@desk.test");
principal Bo => User.Single(u => u.Email == "bo@desk.test");

[Test(Phones)]
void a_number_is_proven_by_the_code_texted_to_it() {
  string sent = "";
  runas (AuthBootstrap) { sent = ProvePhone("ada@desk.test", "correct-horse-1", "+46 70 000 00 01"); }
  Assert.Equal("sent", sent);
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000001"); }
  Assert.Equal(6, code.Length);
  // A wrong code is refused, and the number is not recorded.
  var wrong = code == "000000" ? "111111" : "000000";
  runas (AuthBootstrap) { Assert.Throws(() => ProvePhone("ada@desk.test", "correct-horse-1", "+46700000001", wrong)); }
  runas (Ada) { Assert.Null(Me()!.Phone); }
  runas (AuthBootstrap) { ProvePhone("ada@desk.test", "correct-horse-1", "+46700000001", code); }
  runas (Ada) {
    Assert.Equal("+46700000001", MyPhone().Number);
    Assert.True(MyPhone().Proven);
  }
  // …and the recording sender really is handed the text once its delivery runs (after the commit).
  runas (AuthBootstrap) {
    foreach (var sms in OutgoingSms.Where(m => m.To == "+46700000001").ToList()) { Workflow.Settle(sms); }
  }
  runas (Ada) { Assert.True(Texted.Any(t => t.To == "+46700000001" && t.Text.StartsWith(code))); }
  runas (AuthBootstrap) { Assert.Equal(1, MailsTo("ada@desk.test", "A phone number was added")); }
}

/// `count` codes texted to Ada's `phone` to prove it, long since spent — a number she has been sent codes for before.
void SpentCodes(string phone, int count) {
  runas (AuthBootstrap) {
    var ada = User.Single(u => u.Email == "ada@desk.test");
    var then = DateTime.UtcNow.AddDays(-30);
    for (var i = 0; i < count; i++) {
      new OneTimeCode { Account = ada, Channel = CodeChannel.Sms, Purpose = CodePurpose.ProvePhone, Destination = phone,
                        CodeHash = "spent-" + i, Nonce = "spent-" + i, ExpiresAt = then, UsedAt = then };
    }
  }
}

/// ⭐ A WRONG CODE IS ONE WRONG TRY, HOWEVER MANY CODES THE NUMBER WAS SENT BEFORE — and it reads the same. A typed code
/// is compared with the live code only: compared with every code ever sent, each spent one counted a wrong try against
/// the account, and somebody texted ten codes over time was locked out by one typo.
[Test(Phones)]
void a_wrong_code_is_one_wrong_try_however_many_codes_the_number_was_sent_before() {
  // Without history: one wrong code, and the rows it read.
  runas (AuthBootstrap) { ProvePhone("ada@desk.test", "correct-horse-1", "+46700000001"); }
  var fresh = 0;
  runas (AuthBootstrap) {
    var mark = Cost.Mark();
    Assert.Throws(() => ProvePhone("ada@desk.test", "correct-horse-1", "+46700000001", "000000x"));
    fresh = Cost.RowsReadSince(mark);
  }
  // Ten codes sent to the next number before, all spent.
  SpentCodes("+46700000004", 10);
  runas (AuthBootstrap) { ProvePhone("ada@desk.test", "correct-horse-1", "+46700000004"); }
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000004"); }
  var wrong = code == "000000" ? "111111" : "000000";
  var sent = 0;
  runas (AuthBootstrap) {
    var mark = Cost.Mark();
    Assert.Throws(() => ProvePhone("ada@desk.test", "correct-horse-1", "+46700000004", wrong));
    sent = Cost.RowsReadSince(mark);
  }
  // The right code is still accepted: two wrong tries so far, nowhere near the lock-out.
  runas (AuthBootstrap) { ProvePhone("ada@desk.test", "correct-horse-1", "+46700000004", code); }
  runas (Ada) { Assert.Equal("+46700000004", MyPhone().Number); }
  Log.Information("A wrong code read " + fresh + " rows with no codes sent before, " + sent + " with ten");
  Assert.Equal(fresh, sent);
}

[Test(Phones)]
void proving_a_number_needs_the_password() {
  runas (AuthBootstrap) { Assert.Throws(() => ProvePhone("ada@desk.test", "wrong-password", "+46700000001")); }
  runas (AuthBootstrap) { Assert.Equal(0, TextsTo("+46700000001")); }
}

[Test(Phones)]
void an_account_cannot_write_its_own_number_and_nobody_reads_anothers() {
  runas (Ada) { Assert.Denied(() => SetPhone("ada@desk.test", "+46709999999")); }
  // Bo reads his own number; Ada, signed in, does not read it.
  runas (Bo) { Assert.Equal("+46700000002", MyPhone().Number); }
  runas (Ada) { Assert.Null(User.Single(u => u.Email == "bo@desk.test").Phone); }
}

[Test(Phones)]
void a_proven_number_signs_in_with_a_texted_code() {
  SignInStep asked = new SignInStep();
  runas (AuthBootstrap) { asked = SignInWithPhone("+46 70 000 00 02"); }
  Assert.True(asked.CodeSent);
  Assert.Equal("", asked.Ticket);
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000002"); }
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithPhone("+46700000002", code); }
  Assert.NotEqual("", step.Ticket);
}

[Test(Phones)]
void an_unknown_number_is_answered_as_a_known_one_and_texted_nothing() {
  SignInStep unknown = new SignInStep();
  SignInStep known = new SignInStep();
  runas (AuthBootstrap) { unknown = SignInWithPhone("+46700000009"); known = SignInWithPhone("+46700000002"); }
  Assert.Equal(known.CodeSent, unknown.CodeSent);
  Assert.Equal(known.Ticket, unknown.Ticket);
  runas (AuthBootstrap) {
    Assert.Equal(0, TextsTo("+46700000009"));
    Assert.Equal(1, TextsTo("+46700000002"));
  }
  runas (AuthBootstrap) { Assert.Throws(() => SignInWithPhone("+46700000009", "123456")); }
}

[Test(Phones)]
void a_number_is_texted_a_sign_in_code_at_most_once_a_minute() {
  runas (AuthBootstrap) { SignInWithPhone("+46700000002"); SignInWithPhone("+46700000002"); }
  runas (AuthBootstrap) { Assert.Equal(1, TextsTo("+46700000002")); }
}

[Test(Phones)]
void a_texted_second_step_asks_for_the_code_after_the_password() {
  runas (AuthBootstrap) { SetSmsSecondStep("bo@desk.test", "correct-horse-2", true); }
  SignInStep first = new SignInStep();
  runas (AuthBootstrap) { first = SignIn("bo@desk.test", "correct-horse-2"); }
  Assert.Equal("", first.Ticket);
  Assert.NotEqual("", first.Challenge);
  Assert.Equal("sms", first.ChallengeBy);
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000002"); }
  string ticket = "";
  runas (AuthBootstrap) { ticket = SignInWithCode(first.Challenge, code); }
  Assert.NotEqual("", ticket);
}

[Test(Phones)]
void a_texted_step_is_not_a_second_factor_the_app_can_require() {
  // SECURITY-INVARIANT(accounts-sms-is-not-a-required-second-factor): Root is an admin, and admins MUST use a second
  // factor. Root chose a texted code — and is still asked to set up an authenticator app, with no ticket and no text.
  runas (AuthBootstrap) { SetSmsSecondStep("root@desk.test", "correct-horse-3", true); }
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignIn("root@desk.test", "correct-horse-3"); }
  Assert.True(step.MustEnrol);
  Assert.Equal("", step.Ticket);
  Assert.Equal("", step.Challenge);
  runas (AuthBootstrap) { Assert.Equal(0, TextsTo("+46700000003")); }
}

[Test(Phones)]
void a_texted_challenge_made_before_the_app_required_a_factor_does_not_let_the_account_in() {
  runas (AuthBootstrap) { SetSmsSecondStep("bo@desk.test", "correct-horse-2", true); }
  SignInStep first = new SignInStep();
  runas (AuthBootstrap) { first = SignIn("bo@desk.test", "correct-horse-2"); }
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000002"); }
  // Bo is made an admin between the password and the code.
  runas (AuthBootstrap) { new RoleGrant { Member = User.Single(u => u.Email == "bo@desk.test"), Role = AppRole.Admin }; }
  runas (AuthBootstrap) { Assert.Throws(() => SignInWithCode(first.Challenge, code)); }
}

[Test(Phones)]
void a_phone_that_is_the_second_step_does_not_sign_in_alone() {
  runas (AuthBootstrap) { SetSmsSecondStep("bo@desk.test", "correct-horse-2", true); }
  SignInStep asked = new SignInStep();
  runas (AuthBootstrap) { asked = SignInWithPhone("+46700000002"); }
  Assert.True(asked.CodeSent);   // answered as any number is…
  runas (AuthBootstrap) {
    // …but texted how to sign in, not a code.
    Assert.Equal(1, TextsTo("+46700000002"));
    Assert.True(OutgoingSms.Any(m => m.To == "+46700000002" && m.Text.StartsWith("Sign in to Kit Test Desk with your password")));
    Assert.False(OneTimeCode.Any(c => c.Destination == "+46700000002" && c.Purpose == CodePurpose.SignIn));
  }
}

[Test(Phones)]
void turning_the_texted_step_off_takes_a_code_from_the_phone() {
  runas (AuthBootstrap) { SetSmsSecondStep("bo@desk.test", "correct-horse-2", true); }
  string answer = "";
  runas (AuthBootstrap) { answer = SetSmsSecondStep("bo@desk.test", "correct-horse-2", false); }
  Assert.Equal("sent", answer);
  runas (Bo) { Assert.True(MyPhone().SecondStep); }   // the password alone changed nothing
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000002"); }
  runas (AuthBootstrap) { SetSmsSecondStep("bo@desk.test", "correct-horse-2", false, code); }
  runas (Bo) { Assert.False(MyPhone().SecondStep); }
}

[Test(Phones)]
void a_reset_link_does_not_sign_in_an_account_with_a_texted_step() {
  runas (AuthBootstrap) { SetSmsSecondStep("bo@desk.test", "correct-horse-2", true); }
  runas (AuthBootstrap) { RequestPasswordReset("bo@desk.test"); }
  string token = "";
  runas (AuthBootstrap) { token = TokenIn("bo@desk.test", "/reset-password/"); }
  string ticket = "x";
  runas (AuthBootstrap) { ticket = ResetPassword(token, "a-brand-new-pass"); }
  Assert.Equal("", ticket);
}

// ⭐ AN APP'S OWN DOOR PROVES A NUMBER FOR AN ACCOUNT IT HAS ESTABLISHED (`TextPhoneCode` + `ProvePhoneCode`) — no password
//    asked, because the door has already said who this is (an account made by a provider's sign-in has no password at all).
//    The same codes, the same wrong-try rule, and the number recorded only by the right code.
[Test(Phones)]
void an_apps_own_door_proves_a_number_without_a_password() {
  string kept = "";
  runas (AuthBootstrap) { kept = TextPhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46 70 000 00 01"); }
  Assert.Equal("+46700000001", kept);
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000001"); }
  Assert.Equal(6, code.Length);
  var wrong = code == "000000" ? "111111" : "000000";
  runas (AuthBootstrap) { Assert.Throws(() => ProvePhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46700000001", wrong)); }
  runas (Ada) { Assert.Null(Me()!.Phone); }
  runas (AuthBootstrap) { ProvePhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46700000001", code); }
  runas (Ada) {
    Assert.Equal("+46700000001", MyPhone().Number);
    Assert.True(MyPhone().Proven);
  }
}

// ⭐ ONE PHONE, SEVERAL ACCOUNTS — people may keep more than one. Ada proves the number Bo
// has already proven — with a code texted for HER (a code texted to the same number for Bo proves nothing for her), her
// second step works from it as his does — and then the number signs in neither of them by itself.
// SECURITY-INVARIANT(accounts-a-shared-number-signs-in-no-one-by-itself).
[Test(Phones)]
void a_number_two_accounts_share_is_proven_by_each_and_signs_in_neither() {
  // A code issued while the number was Bo's alone…
  runas (AuthBootstrap) { SignInWithPhone("+46700000002"); }
  string bosSignInCode = "";
  runas (AuthBootstrap) { bosSignInCode = TextedCode("+46700000002"); }
  // A code texted to prove this number for Bo, typed into Ada's proof of the same number, is a wrong code: codes are
  // each account's own.
  runas (AuthBootstrap) { Assert.Equal("sent", ProvePhone("bo@desk.test", "correct-horse-2", "+46700000002")); }
  string bosProveCode = "";
  runas (AuthBootstrap) { bosProveCode = TextedCode("+46700000002"); }
  runas (AuthBootstrap) {
    Assert.Throws(() => ProvePhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46700000002", bosProveCode));
  }
  runas (Ada) { Assert.Null(Me()!.Phone); }
  // Ada proves it with her own code.
  runas (AuthBootstrap) { TextPhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46 70 000 00 02"); }
  string adasCode = "";
  runas (AuthBootstrap) { adasCode = TextedCode("+46700000002"); }
  runas (AuthBootstrap) { ProvePhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46700000002", adasCode); }
  runas (Ada) { Assert.Equal("+46700000002", MyPhone().Number); Assert.True(MyPhone().Proven); }
  runas (Bo) { Assert.Equal("+46700000002", MyPhone().Number); Assert.True(MyPhone().Proven); }

  // The code issued before the number was shared no longer signs Bo in.
  runas (AuthBootstrap) { Assert.Throws(() => SignInWithPhone("+46700000002", bosSignInCode)); }
  // Asked for a code now, the number is answered as any number is — and texted how to sign in, never a code.
  SignInStep shared = new SignInStep();
  SignInStep unknown = new SignInStep();
  runas (AuthBootstrap) { shared = SignInWithPhone("+46700000002"); unknown = SignInWithPhone("+46700000009"); }
  Assert.Equal(unknown.CodeSent, shared.CodeSent);
  Assert.Equal(unknown.Ticket, shared.Ticket);
  runas (AuthBootstrap) {
    Assert.True(OutgoingSms.Any(m => m.To == "+46700000002" && m.Text.Contains("this number is on more than one account")));
    var now = DateTime.UtcNow;
    Assert.False(OneTimeCode.Any(c => c.Destination == "+46700000002" && c.Purpose == CodePurpose.SignIn && c.UsedAt == null
                                      && c.ExpiresAt > now));
  }

  // Each account's second step is its own, from the same phone.
  runas (AuthBootstrap) { SetSmsSecondStep("ada@desk.test", "correct-horse-1", true); SetSmsSecondStep("bo@desk.test", "correct-horse-2", true); }
  foreach (var who in new List<string> { "ada@desk.test", "bo@desk.test" }) {
    var password = who == "ada@desk.test" ? "correct-horse-1" : "correct-horse-2";
    SignInStep first = new SignInStep();
    runas (AuthBootstrap) { first = SignIn(who, password); }
    Assert.Equal("sms", first.ChallengeBy);
    string code = "";
    runas (AuthBootstrap) { code = TextedCode("+46700000002"); }
    string ticket = "";
    runas (AuthBootstrap) { ticket = SignInWithCode(first.Challenge, code); }
    Assert.NotEqual("", ticket);
  }
}

// …and when the second account turns its texted step on, one sign-in-capable account is left behind the number: it
// signs in by text again, and only that one.
[Test(Phones)]
void a_shared_number_signs_in_the_one_account_left_that_may_use_it() {
  runas (AuthBootstrap) { TextPhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46700000002"); }
  string adasCode = "";
  runas (AuthBootstrap) { adasCode = TextedCode("+46700000002"); }
  runas (AuthBootstrap) { ProvePhoneCode(User.Single(u => u.Email == "ada@desk.test"), "+46700000002", adasCode); }
  runas (AuthBootstrap) { SetSmsSecondStep("bo@desk.test", "correct-horse-2", true); }
  runas (AuthBootstrap) { SignInWithPhone("+46700000002"); }
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000002"); }
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithPhone("+46700000002", code); }
  Assert.NotEqual("", step.Ticket);
  runas (AuthBootstrap) {
    Assert.True(OneTimeCode.Any(c => c.Destination == "+46700000002" && c.Purpose == CodePurpose.SignIn
                                     && c.Account.Email == "ada@desk.test"));
    Assert.False(OneTimeCode.Any(c => c.Destination == "+46700000002" && c.Purpose == CodePurpose.SignIn
                                      && c.Account.Email == "bo@desk.test"));
  }
}
