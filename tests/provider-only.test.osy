// "Sign-in only through the provider" (`AccountsSetup.ProviderOnly`), at every door the kit has — SECURITY-INVARIANT
// provider-only-on-every-door. The desk's rule is `google acme.test`: an acme.test account is given a ticket only by
// a Google sign-in whose seal carries acme.test. `TestOAuth.PendingToken(address, provider, "", hostedDomain)` makes the
// seal the platform's callback would hand the provider sign-in page; the provider's type is its name, lower-case.

using Osysharp.Identity;
using Osysharp.UserAccounts;

[TestFixture]
void AcmeDesk() {
  var ada = new User { Email = "ada@acme.test", DisplayName = "Ada", PasswordHash = Security.HashPassword("correct-horse-1"),
                       EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = ada, Role = AppRole.Member };
  var bo = new User { Email = "bo@desk.test", DisplayName = "Bo", PasswordHash = Security.HashPassword("battery-staple-2"),
                      EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = bo, Role = AppRole.Member };
  // An admin on acme.test, whom the desk requires to use two-step sign-in, who has not set it up.
  var root = new User { Email = "root@acme.test", DisplayName = "Root", PasswordHash = Security.HashPassword("correct-horse-9"),
                        EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = root, Role = AppRole.Admin };
}

void AcmeSignsInWithGoogle() { DeskProviderOnly.Stub(() => "google acme.test"); }

string Said() { return "acme.test accounts sign in with Google."; }

[Test(AcmeDesk)]
void password_refused_when_provider_only() {
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignIn("ada@acme.test", "correct-horse-1")).Message); }
  // …and a changed password's fresh ticket is a ticket from a password too.
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => ChangePassword("ada@acme.test", "correct-horse-1", "a-whole-new-one-1")).Message); }
  runas (AuthBootstrap) { Assert.Null(User.Single(u => u.Email == "ada@acme.test").LastLoginAt); }
}

[Test(AcmeDesk)]
void reset_link_refused_when_provider_only() {
  runas (AuthBootstrap) { RequestPasswordReset("ada@acme.test"); }
  string token = "";
  runas (AuthBootstrap) { token = TokenIn("ada@acme.test", "/reset-password/"); }
  Assert.NotEqual("", token);
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => ResetPassword(token, "a-whole-new-one-1")).Message); }
}

[Test(AcmeDesk)]
void passkey_refused_when_provider_only() {
  var key = WebAuthn.NewTestKey();
  PasskeyAdding first = new PasskeyAdding();
  runas (AuthBootstrap) { first = AddPasskey("ada@acme.test", "correct-horse-1"); }
  runas (AuthBootstrap) {
    AddPasskey("ada@acme.test", "", "", "", "", "", first.Token, WebAuthn.TestCreate(key, first.Options, PasskeyOrigin()), "MacBook");
  }
  string handle = "";
  runas (AuthBootstrap) { handle = PasskeyHandle(User.Single(u => u.Email == "ada@acme.test")); }
  AcmeSignsInWithGoogle();
  PasskeyStart start = new PasskeyStart();
  runas (AuthBootstrap) { start = StartPasskeySignIn(); }
  var answer = WebAuthn.TestGet(key, start.Options, PasskeyOrigin(), handle, 1, true);
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithPasskey(start.Token, answer)).Message); }
}

[Test(AcmeDesk)]
void code_step_keeps_the_provider_way() {
  var totp = NewSecondFactorSetup("ada@acme.test").Key;
  SecondFactorOn adas = new SecondFactorOn();
  runas (AuthBootstrap) { adas = EnableSecondFactor("ada@acme.test", "correct-horse-1", totp, Totp.Code(totp)); }
  var spare = adas.RecoveryCodes[0];
  // Before the rule: Ada's password answers a code step, and Root's (who must set two-step sign-in up) an enrolment.
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignIn("ada@acme.test", "correct-horse-1"); }
  var byPassword = step.Challenge;
  Assert.NotEqual("", byPassword);
  runas (AuthBootstrap) { step = SignIn("root@acme.test", "correct-horse-9"); }
  Assert.True(step.MustEnrol);
  var enrolledByPassword = step.Enrolment;
  AcmeSignsInWithGoogle();
  // Through Google with Acme's domain: a code step, and the code admits — the challenge kept the way.
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "acme.test")); }
  Assert.NotEqual("", step.Challenge);
  Assert.Equal("", step.Ticket);
  string ticket = "";
  runas (AuthBootstrap) { ticket = SignInWithCode(step.Challenge, Totp.Code(totp, DateTime.UtcNow.AddSeconds(30))); }
  Assert.NotEqual("", ticket);
  // The password's code step kept its way too: a right code (a recovery code) is refused at the ticket.
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithCode(byPassword, spare)).Message); }
  // …and so is the password's enrolment; Google's enrolment admits.
  var key = NewSecondFactorSetup("root@acme.test").Key;
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => EnableSecondFactor("", "", key, Totp.Code(key), enrolledByPassword)).Message); }
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("root@acme.test", "Google", "", "acme.test")); }
  Assert.True(step.MustEnrol);
  SecondFactorOn on = new SecondFactorOn();
  runas (AuthBootstrap) { on = EnableSecondFactor("", "", key, Totp.Code(key), step.Enrolment); }
  Assert.NotEqual("", on.Ticket);
}

[Test(AcmeDesk)]
void provider_with_other_hd_is_refused() {
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "rival.test"))).Message); }
  // A consumer Google account on the same address carries no organisation at all.
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google"))).Message); }
}

[Test(AcmeDesk)]
void other_provider_same_domain_refused() {
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Microsoft", "", "acme.test"))).Message); }
}

[Test(AcmeDesk)]
void provider_with_the_hd_signs_in() {
  AcmeSignsInWithGoogle();
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "ACME.test")); }
  Assert.NotEqual("", step.Ticket);
  // A new acme.test person, made by the Google sign-in, is admitted the same way.
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("cy@acme.test", "Google", "", "acme.test")); }
  Assert.NotEqual("", step.Ticket);
}

[Test(AcmeDesk)]
void unbound_domain_signs_in_as_today() {
  AcmeSignsInWithGoogle();
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignIn("bo@desk.test", "battery-staple-2"); }
  Assert.NotEqual("", step.Ticket);
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("bo@desk.test", "GitHub")); }
  Assert.NotEqual("", step.Ticket);
}

[Test(AcmeDesk)]
void rule_ignores_the_links_stored_domain() {
  // Ada links Google while she is in Acme's Workspace: the link keeps acme.test.
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "acme.test")); }
  Assert.NotEqual("", step.Ticket);
  // She leaves it; the same Google identity now carries no organisation, and the link's acme.test is not asked.
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google"))).Message); }
}

[Test]
void provider_only_value_checked() {
  Assert.Equal("", ProviderOnlyProblem(""));
  Assert.Equal("", ProviderOnlyProblem("google acme.com,acme.se"));
  Assert.Equal("", ProviderOnlyProblem("Microsoft acme.com, 8f1d2c3b-4a5e-4f60-9a7b-0c1d2e3f4a5b"));
  Assert.Contains("'github' is not a provider", ProviderOnlyProblem("github acme.com"));
  Assert.Contains("'oidc' is not a provider", ProviderOnlyProblem("oidc acme.com"));
  Assert.Contains("a space, then the domains", ProviderOnlyProblem("google"));
  Assert.Contains("'acme' is not a domain", ProviderOnlyProblem("google acme"));
  Assert.Contains("at least one domain", ProviderOnlyProblem("google , ,"));
}

