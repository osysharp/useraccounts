[Test(AcmeDesk)]
void an_app_override_cannot_unbind() {
  // The desk's `SignInRules` (`DeskOwnRules`) says nobody is bound; the organisation's lock still binds Ada.
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignIn("ada@acme.test", "correct-horse-1")).Message); }
}

[Test(AcmeDesk)]
void a_malformed_lock_refuses_every_sign_in() {
  // A locked value this kit can't read (an `oidc` rule, which the save refuses) binds everybody, not nobody.
  DeskProviderOnly.Stub(() => "oidc acme.test");
  runas (AuthBootstrap) { Assert.Contains("not possible here", Assert.Throws<ValidationException>(() => SignIn("bo@desk.test", "battery-staple-2")).Message); }
  runas (AuthBootstrap) { Assert.Contains("not possible here", Assert.Throws<ValidationException>(() => SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "acme.test"))).Message); }
}

[Test(AcmeDesk)]
void a_subdomain_address_is_bound() {
  runas (AuthBootstrap) {
    new User { Email = "eu@eu.acme.test", DisplayName = "Eu", PasswordHash = Security.HashPassword("correct-horse-3"), EmailVerifiedAt = DateTime.UtcNow };
    new User { Email = "dot@acme.test.", DisplayName = "Dot", PasswordHash = Security.HashPassword("correct-horse-4"), EmailVerifiedAt = DateTime.UtcNow };
    new User { Email = "eve@acme.test.evil.test", DisplayName = "Eve", PasswordHash = Security.HashPassword("correct-horse-5"), EmailVerifiedAt = DateTime.UtcNow };
  }
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignIn("eu@eu.acme.test", "correct-horse-3")).Message); }
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignIn("dot@acme.test.", "correct-horse-4")).Message); }
  // A look-alike is not Acme's: unbound.
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignIn("eve@acme.test.evil.test", "correct-horse-5"); }
  Assert.NotEqual("", step.Ticket);
  // The subdomain's person through Google with Acme's (primary) hosted domain signs in.
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("eu@eu.acme.test", "Google", "", "acme.test")); }
  Assert.NotEqual("", step.Ticket);
}

