void a_bound_account_cannot_move_its_address() {
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => ChangeEmail("ada@acme.test", "correct-horse-1", "ada@elsewhere.test")).Message); }
  runas (AuthBootstrap) { Assert.Equal("ada@acme.test", User.Single(u => u.DisplayName == "Ada").Email); }
}

[Test(AcmeDesk)]
void sign_up_refused_when_provider_only() {
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignUp("cy@acme.test", "a-long-password-1", "Cy")).Message); }
  runas (AuthBootstrap) { Assert.False(User.Any(u => u.Email == "cy@acme.test")); }
}

[Test(AcmeDesk)]
void remove_password_refused_when_provider_only() {
  var key = WebAuthn.NewTestKey();
  PasskeyAdding first = new PasskeyAdding();
  runas (AuthBootstrap) { first = AddPasskey("ada@acme.test", "correct-horse-1"); }
  runas (AuthBootstrap) {
    AddPasskey("ada@acme.test", "", "", "", "", "", first.Token, WebAuthn.TestCreate(key, first.Options, PasskeyOrigin()), "MacBook");
  }
  string handle = "";
  runas (AuthBootstrap) { handle = PasskeyHandle(User.Single(u => u.Email == "ada@acme.test")); }
  AcmeSignsInWithGoogle();
  // Turning the password off with the passkey is refused: its fresh ticket is not Google's.
  PasskeyStart start = new PasskeyStart();
  runas (AuthBootstrap) { start = StartPasskeySignIn(); }
  var answer = WebAuthn.TestGet(key, start.Options, PasskeyOrigin(), handle, 1, true);
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => RemovePassword("ada@acme.test", start.Token, answer)).Message); }
}

[Test(AcmeDesk)]
void passkey_enrolment_keeps_the_password_way() {
  // Root (who must set two-step sign-in up) is sent to enrol by a password sign-in before the rule…
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignIn("root@acme.test", "correct-horse-9"); }
  Assert.True(step.MustEnrol);
  var key = WebAuthn.NewTestKey();
  PasskeyAdding first = new PasskeyAdding();
  runas (AuthBootstrap) { first = AddPasskey("", "", "", "", "", step.Enrolment); }
  AcmeSignsInWithGoogle();
  // …so the passkey enrolment that finishes it admits with the password's way, and is refused.
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => AddPasskey("", "", "", "", "", step.Enrolment, first.Token, WebAuthn.TestCreate(key, first.Options, PasskeyOrigin()), "MacBook")).Message); }
}

// ── OP-IdP1b4c: the doors 4b left untested, and an override that adds ──

[Test(AcmeDesk)]
void an_override_may_add_a_binding() {
  // The desk's own rule binds its desk.test accounts to Google, on top of the lock: Bo's password is refused…
  DeskBindsItsOwn.Stub(() => true);
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal("desk.test accounts sign in with Google.", Assert.Throws<ValidationException>(() => SignIn("bo@desk.test", "battery-staple-2")).Message); }
  // …Google with the desk's hosted domain admits him, and the lock still binds Ada.
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("bo@desk.test", "Google", "", "desk.test")); }
  Assert.NotEqual("", step.Ticket);
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignIn("ada@acme.test", "correct-horse-1")).Message); }
}

[Test(AcmeDesk)]
void phone_code_refused_when_provider_only() {
  // Ada proves a number before the rule; the rule then refuses the code texted to it at the ticket.
  runas (AuthBootstrap) { ProvePhone("ada@acme.test", "correct-horse-1", "+46700000011"); }
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000011"); }
  runas (AuthBootstrap) { ProvePhone("ada@acme.test", "correct-horse-1", "+46700000011", code); }
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { SignInWithPhone("+46700000011"); }
  runas (AuthBootstrap) { code = TextedCode("+46700000011"); }
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithPhone("+46700000011", code)).Message); }
  runas (AuthBootstrap) { Assert.Null(User.Single(u => u.Email == "ada@acme.test").LastLoginAt); }
}

[Test(AcmeDesk)]
void door_code_refused_when_provider_only() {
  // The mailed door code proves the address; the app's door then continues the sign-in, which is "no provider".
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { MailDoorCode("ada@acme.test"); }
  string code = "";
  runas (AuthBootstrap) { code = CodeIn("ada@acme.test"); }
  Assert.Equal(6, code.Length);
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => ContinueSignIn(ProveDoorCode("ada@acme.test", code))).Message); }
}

