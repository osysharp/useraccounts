void verify_email_code_refused_when_provider_only() {
  // Cy signs up before the rule; the code her mail carried would sign her in, and under the rule it is refused.
  runas (AuthBootstrap) { SignUp("cy@acme.test", "a-long-password-1", "Cy"); }
  string code = "";
  runas (AuthBootstrap) { code = CodeIn("cy@acme.test"); }
  Assert.Equal(6, code.Length);
  AcmeSignsInWithGoogle();
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => VerifyEmailCode("cy@acme.test", code, "a-long-password-1")).Message); }
}

[Test(AcmeDesk)]
void texted_step_keeps_the_way_of_the_first() {
  // Ada proves a number and makes a texted code her second step, before the rule.
  runas (AuthBootstrap) { ProvePhone("ada@acme.test", "correct-horse-1", "+46700000012"); }
  string code = "";
  runas (AuthBootstrap) { code = TextedCode("+46700000012"); }
  runas (AuthBootstrap) { ProvePhone("ada@acme.test", "correct-horse-1", "+46700000012", code); }
  runas (AuthBootstrap) { SetSmsSecondStep("ada@acme.test", "correct-horse-1", true); }
  SignInStep byPassword = new SignInStep();
  runas (AuthBootstrap) { byPassword = SignIn("ada@acme.test", "correct-horse-1"); }
  Assert.Equal("sms", byPassword.ChallengeBy);
  runas (AuthBootstrap) { code = TextedCode("+46700000012"); }
  AcmeSignsInWithGoogle();
  // The password's texted step: the right code is refused at the ticket.
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithCode(byPassword.Challenge, code)).Message); }
  // Google with Acme's domain: a texted step, and its code admits.
  SignInStep byGoogle = new SignInStep();
  runas (AuthBootstrap) { byGoogle = SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "acme.test")); }
  Assert.Equal("sms", byGoogle.ChallengeBy);
  runas (AuthBootstrap) { code = TextedCode("+46700000012"); }
  string ticket = "";
  runas (AuthBootstrap) { ticket = SignInWithCode(byGoogle.Challenge, code); }
  Assert.NotEqual("", ticket);
}

// ── OP-IdP1b5: the challenge keeps the pending TOKEN (review N2), and a password-proved link is judged (review N1). ──

// One account that may reset a second step (and so read challenge rows), and is not the sign-in flow: the column's own
// `deny read` is what keeps the token from it.
policy ResetsSecondFactor => User.Any(u => u == user && u.Email == "reset@acme.test");
principal Resetter => User.Single(u => u.Email == "reset@acme.test");
principal AcmeAda => User.Single(u => u.Email == "ada@acme.test");

[TestFixture(AcmeDesk)]
void AcmeWithAResetDesk() { new User { Email = "reset@acme.test", DisplayName = "Reset desk", EmailVerifiedAt = DateTime.UtcNow }; }

[Test(AcmeWithAResetDesk)]
void the_challenge_token_is_unreadable() {
  var key = NewSecondFactorSetup("ada@acme.test").Key;
  runas (AuthBootstrap) { EnableSecondFactor("ada@acme.test", "correct-horse-1", key, Totp.Code(key, DateTime.UtcNow)); }
  AcmeSignsInWithGoogle();
  SignInStep first = new SignInStep();
  runas (AuthBootstrap) { first = SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "acme.test")); }
  Assert.Equal("app", first.ChallengeBy);
  var hash = TokenHash(first.Challenge);
  // The sign-in flow holds the token — without which the nulls below prove nothing…
  runas (AuthBootstrap) { Assert.NotNull(SignInChallenge.Single(c => c.TokenHash == hash).PendingToken); }
  // …a reader of the rows does not, by a query or a filter on it…
  runas (Resetter) {
    Assert.Equal(1, SignInChallenge.Count(c => c.Account.Email == "ada@acme.test" && c.UsedAt == null));
    Assert.Null(SignInChallenge.Single(c => c.Account.Email == "ada@acme.test" && c.UsedAt == null).PendingToken);
  }
  // …nor the account itself.
  runas (AcmeAda) { Assert.Equal(0, SignInChallenge.Count(c => c.PendingToken != null)); }
  // Spent: the code admits, and the token is gone.
  runas (AuthBootstrap) { Assert.NotEqual("", SignInWithCode(first.Challenge, Totp.Code(key, DateTime.UtcNow.AddSeconds(30)))); }
  runas (AuthBootstrap) { Assert.Null(SignInChallenge.Single(c => c.TokenHash == hash).PendingToken); }
  // Lapsed: a challenge presented after its five minutes is refused, and its token is gone.
  SignInStep second = new SignInStep();
  runas (AuthBootstrap) { second = SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "acme.test")); }
  var lapsed = TokenHash(second.Challenge);
  runas (AuthBootstrap) { Assert.NotNull(SignInChallenge.Single(c => c.TokenHash == lapsed).PendingToken); }
  TestClock.Set(DateTime.UtcNow.AddMinutes(6));
  runas (AuthBootstrap) { Assert.Throws<ValidationException>(() => SignInWithCode(second.Challenge, Totp.Code(key, DateTime.UtcNow))); }
  runas (AuthBootstrap) { Assert.Null(SignInChallenge.Single(c => c.TokenHash == lapsed).PendingToken); }
}

[Test(AcmeDesk)]
void an_insiders_seal_links_nothing_in_the_kit() {
  AcmeSignsInWithGoogle();
  // Mallory, a real Acme member, holds Ada's password and her own Acme Google seal.
  var mallorys = TestOAuth.PendingToken("mallory@acme.test", "Google", "", "acme.test");
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => LinkProvider("ada@acme.test", "correct-horse-1", mallorys)).Message); }
  runas (AuthBootstrap) { Assert.Equal(0, Security.OAuthLinkedProviders(User.Single(u => u.Email == "ada@acme.test").Id).Count); }
}

/// Gives `email` (password `password`) a passkey made while no rule binds it, and answers a sign-in answer for it.
string PasskeyAnswerFor(string email, string password, PasskeyStart start) {
  var key = WebAuthn.NewTestKey();
  PasskeyAdding first = new PasskeyAdding();
  runas (AuthBootstrap) { first = AddPasskey(email, password); }
  runas (AuthBootstrap) {
    AddPasskey(email, "", "", "", "", "", first.Token, WebAuthn.TestCreate(key, first.Options, PasskeyOrigin()), "YubiKey");
  }
  string handle = "";
  runas (AuthBootstrap) { handle = PasskeyHandle(User.Single(u => u.Email == email)); }
  return WebAuthn.TestGet(key, start.Options, PasskeyOrigin(), handle, 1, true);
}

[Test(AcmeDesk)]
void a_waived_passkey_opens_an_added_binding() {
  // OP-IdP1d: the desk's override binds Bo, and waives its binding for a verified passkey (Admin's break-glass key).
  PasskeyStart start = new PasskeyStart();
  runas (AuthBootstrap) { start = StartPasskeySignIn(); }
  var answer = PasskeyAnswerFor("bo@desk.test", "battery-staple-2", start);
  DeskBindsItsOwn.Stub(() => true);
  DeskWaivesPasskeys.Stub(() => true);
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithPasskey(start.Token, answer); }
  Assert.NotEqual("", step.Ticket);
}

[Test(AcmeDesk)]
void break_glass_does_not_open_an_org_app() {
  // OP-IdP1d: one person, one break-glass passkey. Where only Admin's override binds Bo (the desk standing in for Admin), the
  // waiver opens it; where his organisation's LOCK binds him (an organisation's app), the same waiver opens nothing.
  PasskeyStart toAdmin = new PasskeyStart();
  PasskeyStart toTheApp = new PasskeyStart();
  runas (AuthBootstrap) { toAdmin = StartPasskeySignIn(); toTheApp = StartPasskeySignIn(); }
  var intoAdmin = PasskeyAnswerFor("bo@desk.test", "battery-staple-2", toAdmin);
  var intoTheApp = PasskeyAnswerFor("bo@desk.test", "battery-staple-2", toTheApp);
  DeskBindsItsOwn.Stub(() => true);
  DeskWaivesPasskeys.Stub(() => true);
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithPasskey(toAdmin.Token, intoAdmin); }
  Assert.NotEqual("", step.Ticket);
  DeskProviderOnly.Stub(() => "google desk.test");
  runas (AuthBootstrap) {
    Assert.Equal("desk.test accounts sign in with Google.", Assert.Throws<ValidationException>(() => SignInWithPasskey(toTheApp.Token, intoTheApp)).Message);
  }
}

[Test(AcmeDesk)]
void a_password_is_never_waived() {
  // The waiver is asked only for a passkey: Bo's password stays bound by the override.
  DeskBindsItsOwn.Stub(() => true);
  DeskWaivesPasskeys.Stub(() => true);
  runas (AuthBootstrap) { Assert.Equal("desk.test accounts sign in with Google.", Assert.Throws<ValidationException>(() => SignIn("bo@desk.test", "battery-staple-2")).Message); }
}

[Test(AcmeDesk)]
void the_lock_beats_a_break_glass_passkey() {
  // The organisation's LOCK binds Ada; the desk's override waives every passkey. The lock is never waived.
  PasskeyStart start = new PasskeyStart();
  runas (AuthBootstrap) { start = StartPasskeySignIn(); }
  var answer = PasskeyAnswerFor("ada@acme.test", "correct-horse-1", start);
  AcmeSignsInWithGoogle();
  DeskWaivesPasskeys.Stub(() => true);
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => SignInWithPasskey(start.Token, answer)).Message); }
}

// ── ORGPOL OP-OC1c1-2: a rule that names the organisation's own client (`client:<key> <domain>[,…]`) ──
// The seal's client name is `org:<key>` for an organisation's client; the issuer is judged at the platform's mint.

void AcmeSignsInWithItsOkta() { DeskProviderOnly.Stub(() => "client:acme-okta acme.test"); }

[Test]
void a_client_rule_value_is_checked() {
  Assert.Equal("", ProviderOnlyProblem("client:acme-okta acme.test,acme.se"));
  Assert.Equal("", ProviderOnlyProblem("Client:Acme-Okta acme.test"));
  Assert.Contains("'acme_okta' is not a client key", ProviderOnlyProblem("client:acme_okta acme.test"));
  Assert.Contains("'' is not a client key", ProviderOnlyProblem("client: acme.test"));
  Assert.Contains("is not a domain", ProviderOnlyProblem("client:acme-okta 8f1d2c3b-4a5e-4f60-9a7b-0c1d2e3f4a5b"));
}

[Test(AcmeDesk)]
void a_client_rule_admits_only_its_client() {
  AcmeSignsInWithItsOkta();
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "org:acme-okta")); }
  Assert.NotEqual("", step.Ticket);
  var said = "acme.test accounts sign in with acme-okta.";
  // Another of the organisation's clients, Google with Acme's own Workspace, and a password are each refused.
  runas (AuthBootstrap) { Assert.Equal(said, Assert.Throws<ValidationException>(() => SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "org:rival-okta"))).Message); }
  runas (AuthBootstrap) { Assert.Equal(said, Assert.Throws<ValidationException>(() => SignInWithProvider(TestOAuth.PendingToken("ada@acme.test", "Google", "", "acme.test"))).Message); }
  runas (AuthBootstrap) { Assert.Equal(said, Assert.Throws<ValidationException>(() => SignIn("ada@acme.test", "correct-horse-1")).Message); }
  // An address the rule does not list signs in as today.
  runas (AuthBootstrap) { step = SignIn("bo@desk.test", "battery-staple-2"); }
  Assert.NotEqual("", step.Ticket);
}

/// `MustEnrol(account)` with no way — the form the kit offered before the way was kept — is a sign-in not through a
/// provider: under the rule its enrolment is refused when two-step sign-in is set up, as a password's is.
[Test(AcmeDesk)]
void an_enrolment_made_without_a_way_is_refused_under_the_rule() {
  AcmeSignsInWithGoogle();
  SignInStep step = new SignInStep();
  runas (AuthBootstrap) { step = MustEnrol(User.Single(u => u.Email == "root@acme.test")); }
  Assert.True(step.MustEnrol);
  var key = NewSecondFactorSetup("root@acme.test").Key;
  runas (AuthBootstrap) { Assert.Equal(Said(), Assert.Throws<ValidationException>(() => EnableSecondFactor("", "", key, Totp.Code(key), step.Enrolment)).Message); }
}
