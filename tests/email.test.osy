// An address is proven by a message it receives — verified, and changed only from the new address's own link.

using Osysharp.Identity;
using Osysharp.UserAccounts;

[TestFixture]
void People() {
  new User { Email = "ada@desk.test", DisplayName = "Ada", PasswordHash = Security.HashPassword("correct-horse-1") };
  new User { Email = "bo@desk.test", DisplayName = "Bo", PasswordHash = Security.HashPassword("correct-horse-2"),
             EmailVerifiedAt = DateTime.UtcNow };
}

principal Ada => User.Single(u => u.Email == "ada@desk.test");

[Test(People)]
void opening_the_link_proves_the_address() {
  runas (AuthBootstrap) { SignIn("ada@desk.test", "correct-horse-1"); }   // an unproven account is sent a link
  string token = "";
  runas (AuthBootstrap) { token = TokenIn("ada@desk.test", "/verify-email/"); }
  Assert.NotEqual("", token);
  // Ada's account had its password before its address was proven, so the link proves it WITH that password (her first
  // proof — tests/pre-hijack.test.osy); proven, and signed in as a sign-in would be.
  SignInStep proven = new SignInStep();
  runas (AuthBootstrap) { proven = VerifyEmail(token, "correct-horse-1"); }
  Assert.NotEqual("", proven.Ticket);
  runas (AuthBootstrap) { Assert.NotNull(User.Single(u => u.Email == "ada@desk.test").EmailVerifiedAt); }
  // Once only: opened again it signs nobody in, and says the address is already the account's.
  SignInStep again = new SignInStep();
  runas (AuthBootstrap) { again = VerifyEmail(token, "correct-horse-1"); }
  Assert.True(again.AlreadyProven);
  Assert.Equal("", again.Ticket);
}

[Test(People)]
void signing_in_again_does_not_mail_a_second_link_while_the_first_is_live() {
  runas (AuthBootstrap) { SignIn("ada@desk.test", "correct-horse-1"); }
  runas (AuthBootstrap) { SignIn("ada@desk.test", "correct-horse-1"); }
  runas (AuthBootstrap) { Assert.Equal(1, MailsTo("ada@desk.test", "Confirm your address")); }
}

[Test(People)]
void a_new_address_takes_effect_only_from_its_own_link() {
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "Bo.New@desk.test"); }
  runas (AuthBootstrap) {
    // Nothing moved yet; the old address was told, the new one was sent the link.
    Assert.True(User.Any(u => u.Email == "bo@desk.test"));
    Assert.Equal(1, MailsTo("bo@desk.test", "Your Kit Test Desk address is changing"));
    Assert.Equal(1, MailsTo("bo.new@desk.test", "Confirm your new address"));
  }
  string token = "";
  runas (AuthBootstrap) { token = TokenIn("bo.new@desk.test", "/verify-email/"); }
  runas (AuthBootstrap) { VerifyEmail(token); }
  runas (AuthBootstrap) {
    var bo = User.Single(u => u.DisplayName == "Bo");
    Assert.Equal("bo.new@desk.test", bo.Email);
    Assert.NotNull(bo.EmailVerifiedAt);
  }
  // …and the account signs in with the new address, not the old.
  string withNew = "";
  string withOld = "x";
  runas (AuthBootstrap) { withNew = SignIn("bo.new@desk.test", "correct-horse-2").Ticket; withOld = SignIn("bo@desk.test", "correct-horse-2").Ticket; }
  Assert.NotEqual("", withNew);
  Assert.Equal("", withOld);
}

[Test(People)]
void changing_the_address_needs_the_current_password() {
  runas (AuthBootstrap) { Assert.Throws(() => ChangeEmail("bo@desk.test", "wrong-password", "bo.new@desk.test")); }
  runas (AuthBootstrap) { Assert.Equal(0, MailsTo("bo.new@desk.test", "")); }
}

[Test(People)]
void an_address_another_account_uses_is_refused() {
  runas (AuthBootstrap) { Assert.Throws(() => ChangeEmail("bo@desk.test", "correct-horse-2", "ada@desk.test")); }
}

[Test(People)]
void a_verification_link_is_refused_after_three_days() {
  runas (AuthBootstrap) { SignIn("ada@desk.test", "correct-horse-1"); }
  string token = "";
  runas (AuthBootstrap) { token = TokenIn("ada@desk.test", "/verify-email/"); }
  TestClock.Advance(TimeSpan.FromDays(3) + TimeSpan.FromMinutes(1));
  runas (AuthBootstrap) { Assert.Throws(() => VerifyEmail(token)); }
}

// SECURITY-INVARIANT(accounts-an-address-moves-only-when-the-new-one-confirms): the address is written by
// `ConfirmAddressChange` alone (and the desk's recorded run). Before 1.0.0 the sign-in flow could write it anywhere —
// Osysharp.Identity's floor denies it only to everybody ELSE — so the sign-in flow's own write outside the confirmation
// is what proves `User`'s own deny.
[Test(People)]
void an_address_changes_only_through_its_confirmation() {
  runas (Ada) { Assert.Denied(() => MoveAddress("ada@desk.test", "mallory@desk.test")); }
  runas (AuthBootstrap) { Assert.Denied(() => MoveAddress("bo@desk.test", "mallory@desk.test")); }
  runas (AuthBootstrap) { Assert.True(User.Any(u => u.Email == "bo@desk.test")); }
  // …and through it, it moves.
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "bo.moved@desk.test"); }
  string token = "";
  runas (AuthBootstrap) { token = TokenIn("bo.moved@desk.test", "/verify-email/"); }
  runas (AuthBootstrap) { VerifyEmail(token); }
  runas (AuthBootstrap) { Assert.Equal("bo.moved@desk.test", User.Single(u => u.DisplayName == "Bo").Email); }
}

// The same write, made the way a rogue page makes it: the browser changes the field on the signed-in account's own row
// and commits — a client's unit of work, sent to the server as a delta. Refused, and the address stays.
[Test(People)]
void a_browser_cannot_move_its_own_account_to_another_address() {
  Ui.Visit("/login");
  Ui.Fill("Email", "bo@desk.test");
  Ui.Fill("Password", "correct-horse-2");
  Ui.Click("Sign in");
  Ui.Visit("/test/move-my-address");
  Ui.Click("Move my address");
  Assert.Visible("Refused");
  runas (AuthBootstrap) { Assert.True(User.Any(u => u.Email == "bo@desk.test")); }
  runas (AuthBootstrap) { Assert.False(User.Any(u => u.Email == "mallory@desk.test")); }
}

[Test(People)]
void a_signed_in_account_cannot_verify_itself_or_move_its_own_address() {
  runas (Ada) { Assert.Denied(() => MarkVerified("ada@desk.test")); }
  runas (Ada) { Assert.Denied(() => MoveAddress("ada@desk.test", "mallory@desk.test")); }
  // …nor make a verification whose token it would know.
  runas (Ada) {
    Assert.Denied(() => new EmailCheck { Account = User.Single(u => u.Email == "ada@desk.test"), Email = "ada@desk.test",
                                         TokenHash = Crypto.Sha256Hex("known"), ExpiresAt = DateTime.UtcNow.AddDays(1) });
  }
}

// Two asks to move the address mail two links; the account moves on whichever is opened first, and that spends the
// other. Opening the other afterwards is not a failure to report — the change it asked for has happened.
[Test(People)]
void a_second_link_for_a_change_that_already_happened_says_so() {
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "bo.new@desk.test"); }
  string first = "";
  runas (AuthBootstrap) { first = TokenIn("bo.new@desk.test", "/verify-email/"); }
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "bo.new@desk.test"); }
  string second = "";
  runas (AuthBootstrap) { second = TokenIn("bo.new@desk.test", "/verify-email/"); }
  Assert.NotEqual(first, second);
  runas (AuthBootstrap) { VerifyEmail(first); }
  runas (AuthBootstrap) { Assert.Equal("bo.new@desk.test", User.Single(u => u.DisplayName == "Bo").Email); }
  SignInStep again = new SignInStep();
  runas (AuthBootstrap) { again = VerifyEmail(second); }
  Assert.True(again.AlreadyProven);
  Assert.Equal("bo.new@desk.test", again.Account);
  // …and the first one, opened twice, says the same.
  SignInStep twice = new SignInStep();
  runas (AuthBootstrap) { twice = VerifyEmail(first); }
  Assert.True(twice.AlreadyProven);
}

// A link nobody can use still gets the one sentence, whatever is behind it: unknown, expired, or for an address the
// account has since left — a token says nothing about an account but the one it was mailed to, at the address it went to.
[Test(People)]
void a_link_for_an_address_the_account_has_left_is_still_refused() {
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "bo.new@desk.test"); }
  string toNew = "";
  runas (AuthBootstrap) { toNew = TokenIn("bo.new@desk.test", "/verify-email/"); }
  runas (AuthBootstrap) { VerifyEmail(toNew); }
  runas (AuthBootstrap) { ChangeEmail("bo.new@desk.test", "correct-horse-2", "bo.third@desk.test"); }
  string toThird = "";
  runas (AuthBootstrap) { toThird = TokenIn("bo.third@desk.test", "/verify-email/"); }
  runas (AuthBootstrap) { VerifyEmail(toThird); }
  runas (AuthBootstrap) { Assert.Throws(() => VerifyEmail(toNew)); }
  runas (AuthBootstrap) { Assert.Throws(() => VerifyEmail("no-such-token")); }
}

void SignInAsBo() {
  Ui.Visit("/login");
  Ui.Fill("Email", "bo@desk.test");
  Ui.Fill("Password", "correct-horse-2");
  Ui.Click("Sign in");
}

// The account page asks for the change first and the password after — in the same dialog, as its second step — and
// mails nothing until then. One confirmation mails ONE link, and the row then says where it went and offers to send it
// again rather than a second change.
[Test(People)]
void the_account_page_takes_the_change_then_the_password_and_mails_one_link() {
  SignInAsBo();
  Ui.Visit("/account");
  Assert.Hidden("Current password");
  Ui.Click("Change address…");
  Assert.Dialog("Change address");
  Ui.Fill("New address", "bo.new@desk.test");
  Assert.Hidden("Current password");
  Ui.Click("Save");
  Assert.Visible("Current password");
  Assert.Visible("To move your account to bo.new@desk.test, confirm it is you.");
  Ui.Shot("account-confirm-change");
  runas (AuthBootstrap) { Assert.Equal(0, MailsTo("bo.new@desk.test", "")); }
  Ui.Fill("Current password", "correct-horse-2");
  Ui.Click("Confirm");
  Assert.Visible("Confirmation sent to bo.new@desk.test");
  runas (AuthBootstrap) { Assert.Equal(1, MailsTo("bo.new@desk.test", "Confirm your new address")); }
  Assert.Hidden("Change address…");
  Assert.Visible("Resend");
  Ui.Shot("account-address-pending");
  // It is the account's state, not the page's: opened again, the row still says so.
  Ui.Visit("/account");
  Assert.Visible("Confirmation sent to bo.new@desk.test");
  Assert.Hidden("Change address…");
  // Resend asks for the password too, and mails the same address one more link.
  Ui.Click("Resend");
  Ui.Fill("Current password", "correct-horse-2");
  Ui.Click("Confirm");
  runas (AuthBootstrap) { Assert.Equal(2, MailsTo("bo.new@desk.test", "Confirm your new address")); }
}

// With two-step sign-in on, the code is asked for last, beside the password; a wrong one keeps the change and the
// password and asks again, and nothing is mailed until a code fits.
[Test(People)]
void a_wrong_code_on_the_account_page_keeps_the_change_and_asks_again() {
  var key = NewSecondFactorSetup("bo@desk.test").Key;
  SecondFactorOn on = new SecondFactorOn();
  runas (AuthBootstrap) { on = EnableSecondFactor("bo@desk.test", "correct-horse-2", key, Totp.Code(key)); }
  SignInAsBo();
  Ui.Fill("Code", Totp.Code(key, DateTime.UtcNow.AddSeconds(30)));
  Ui.Click("Continue");
  Ui.Visit("/account");
  Ui.Click("Change address…");
  Ui.Fill("New address", "bo.new@desk.test");
  Ui.Click("Save");
  Assert.Visible("Code from your app");
  Ui.Fill("Current password", "correct-horse-2");
  Ui.Fill("Code from your app", "000000");
  Ui.Click("Confirm");
  Assert.Visible("That code is not right — type the newest code your app shows, or a recovery code.");
  Assert.Visible("To move your account to bo.new@desk.test, confirm it is you.");
  Ui.Shot("account-wrong-code");
  runas (AuthBootstrap) { Assert.Equal(0, MailsTo("bo.new@desk.test", "")); }
  // Only the code is typed again: the address and the password are still there.
  Ui.Fill("Code from your app", on.RecoveryCodes[0]);
  Ui.Click("Confirm");
  Assert.Visible("Confirmation sent to bo.new@desk.test");
  runas (AuthBootstrap) { Assert.Equal(1, MailsTo("bo.new@desk.test", "Confirm your new address")); }
}

principal Bo => User.Single(u => u.DisplayName == "Bo");

// The account page reads where a change waits from the account's own checks — and only its own, and never their hash.
[Test(People)]
void an_account_sees_where_its_own_change_waits_and_nothing_more() {
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "bo.new@desk.test"); }
  runas (Bo) {
    Assert.Equal("bo.new@desk.test", MyAddress().Pending);
    Assert.Null(EmailCheck.Single(c => c.Account == Bo).TokenHash);
  }
  runas (Ada) {
    Assert.Equal("", MyAddress().Pending);
    Assert.Equal(0, EmailCheck.Count(c => c.Email == "bo.new@desk.test"));
  }
  // The sign-in flow still reads the hash — without which the null above proves nothing.
  runas (AuthBootstrap) { Assert.NotNull(EmailCheck.Single(c => c.Email == "bo.new@desk.test").TokenHash); }
}

// "This wasn't me — cancel the change": the OLD address is told of a move, and its mail carries a link that calls the
// move off with no password (whoever asked has it). After it, the link and the code the NEW address was sent move
// nothing, and every browser signed in to the account is signed out. Opened again, it says the same and does no more.
// SECURITY-INVARIANT(accounts-the-old-address-can-call-a-move-off).
[Test(People)]
void the_old_address_calls_the_move_off_and_the_new_one_can_no_longer_confirm() {
  string laptop = "";
  runas (AuthBootstrap) { laptop = SignIn("bo@desk.test", "correct-horse-2").Ticket; }
  Assert.Equal(200, Api.Get("/account", bearer: laptop).StatusCode);
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "bo.thief@desk.test"); }
  string cancel = "";
  string confirm = "";
  string code = "";
  runas (AuthBootstrap) {
    cancel = TokenIn("bo@desk.test", "/cancel-address-change/");
    confirm = TokenIn("bo.thief@desk.test", "/verify-email/");
    code = CodeIn("bo.thief@desk.test");
  }
  Assert.NotEqual("", cancel);
  // Opened from the mail, signed out: the page calls the move off and says what that did.
  Ui.Visit($"/cancel-address-change/{cancel}");
  Assert.Visible("The change is cancelled: your account does not move to bo.thief@desk.test.");
  Assert.Visible("Every browser signed in to your account was signed out. Whoever asked knows your password, so choose a new one now.");
  // The moved-to address can no longer confirm — by its link or by its code — and the account stays where it was.
  runas (AuthBootstrap) { Assert.Throws(() => VerifyEmail(confirm)); }
  runas (AuthBootstrap) { Assert.Throws(() => VerifyEmailCode("bo.thief@desk.test", code)); }
  runas (AuthBootstrap) {
    Assert.Equal("bo@desk.test", User.Single(u => u.DisplayName == "Bo").Email);
    Assert.False(User.Any(u => u.Email == "bo.thief@desk.test"));
  }
  // …and whoever asked is signed out.
  Assert.Equal(401, Api.Get("/account", bearer: laptop).StatusCode);
  // Single-use: opened again it answers the same and changes nothing more.
  runas (AuthBootstrap) { Assert.Equal("bo.thief@desk.test", CancelAddressChange(cancel)); }
  runas (AuthBootstrap) { Assert.Throws(() => CancelAddressChange("no-such-token")); }
}

// A mistyped address is called off from the account page — its own act, no password — rather than waited out for three
// days; the link mailed to it then moves nothing. Nothing else about the check is the account's to write.
[Test(People)]
void the_account_page_cancels_a_pending_move() {
  SignInAsBo();
  Ui.Visit("/account");
  Ui.Click("Change address…");
  Ui.Fill("New address", "bo.typo@desk.test");
  Ui.Click("Save");
  Ui.Fill("Current password", "correct-horse-2");
  Ui.Click("Confirm");
  Assert.Visible("Confirmation sent to bo.typo@desk.test");
  Ui.Click("Cancel");
  Assert.Visible("The move to bo.typo@desk.test is cancelled.");
  Assert.Hidden("Confirmation sent to bo.typo@desk.test");
  Assert.Visible("Change address…");
  string confirm = "";
  runas (AuthBootstrap) { confirm = TokenIn("bo.typo@desk.test", "/verify-email/"); }
  runas (AuthBootstrap) { Assert.Throws(() => VerifyEmail(confirm)); }
  runas (AuthBootstrap) { Assert.Equal("bo@desk.test", User.Single(u => u.DisplayName == "Bo").Email); }
  // The account may spend its own pending move, and nothing more: pointing a check at another address is refused.
  runas (AuthBootstrap) { ChangeEmail("bo@desk.test", "correct-horse-2", "bo.second@desk.test"); }
  runas (Bo) { Assert.Denied(() => PointCheckAt("bo.second@desk.test", "mallory@desk.test")); }
  runas (Bo) { Assert.Denied(() => SpendCheck("bo.second@desk.test")); }
}
