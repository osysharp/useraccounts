// Presence — proof, once and for one named act, that the signed-in PERSON is acting: a user-verified passkey answer to a
// ceremony started for that account and act, or the password and an unused authenticator code under the kit's lockout.
// The test plays the device (`WebAuthn.NewTestKey`, `TestCreate`, `TestGet`) and the authenticator app (`Totp.Code`).

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Mail;

[TestFixture]
void PresenceDesk() {
  new User { Email = "ada@desk.test", DisplayName = "Ada", PasswordHash = Security.HashPassword("correct-horse-1"),
             EmailVerifiedAt = DateTime.UtcNow };
  new User { Email = "bo@desk.test", DisplayName = "Bo", PasswordHash = Security.HashPassword("correct-horse-2"),
             EmailVerifiedAt = DateTime.UtcNow };
  // Cy's second step is a code texted to her phone: never presence.
  new User { Email = "cy@desk.test", DisplayName = "Cy", PasswordHash = Security.HashPassword("correct-horse-3"),
             EmailVerifiedAt = DateTime.UtcNow, Phone = "+46700000003", PhoneVerifiedAt = DateTime.UtcNow, SmsSecondStep = true };
}

principal Ada => User.Single(u => u.Email == "ada@desk.test");
principal Bo => User.Single(u => u.Email == "bo@desk.test");
principal Cy => User.Single(u => u.Email == "cy@desk.test");

string ActX() { return "deploy:move-1:version-1:approve"; }
string ActY() { return "deploy:move-2:version-1:approve"; }

/// Two-step sign-in on for `email`, with a fresh authenticator key — answers the key and keeps the recovery codes.
SecondFactorOn PresenceCodesOn(string email, string password, string key) {
  SecondFactorOn on = new SecondFactorOn();
  runas (AuthBootstrap) { on = EnableSecondFactor(email, password, key, Totp.Code(key)); }
  return on;
}

/// The authenticator's code `steps` steps from now (the code just used to turn it on is step 0).
string PresenceCodeAhead(string key, int steps) { return Totp.Code(key, DateTime.UtcNow.AddSeconds(30 * steps)); }

/// A passkey made from `key` on `email`'s account, added on its password.
void PresenceKeyOn(string email, string password, string key) {
  PasskeyAdding first = new PasskeyAdding();
  runas (AuthBootstrap) { first = AddPasskey(email, password); }
  runas (AuthBootstrap) {
    AddPasskey(email, "", "", "", "", "", first.Token, WebAuthn.TestCreate(key, first.Options, PasskeyOrigin()), "MacBook");
  }
}

string PresenceHandleOf(string email) {
  string handle = "";
  runas (AuthBootstrap) { handle = PasskeyHandle(User.Single(u => u.Email == email)); }
  return handle;
}

/// A presence proof written by the desk's own code, past `ProvePresence`.
void HandWrittenPresence(string act) {
  new PresenceProof { Account = Me()!, ActHash = PresenceActHash(act), TokenHash = TokenHash("by-hand-" + act), Way = "app",
                      ExpiresAt = DateTime.UtcNow + PresenceLifetime() };
  UnitOfWork.Commit();
}

[Test(PresenceDesk)]
void presence_with_passkey_for_its_act_is_taken() {
  var key = WebAuthn.NewTestKey();
  PresenceKeyOn("ada@desk.test", "correct-horse-1", key);
  var handle = PresenceHandleOf("ada@desk.test");
  runas (Ada) {
    var start = StartPresence(ActX());
    var proof = Osysharp.UserAccounts.ProvePresence(ActX(), start.Token, WebAuthn.TestGet(key, start.Options, PasskeyOrigin(), handle, 1, true));
    Assert.NotEqual("", proof);
    Assert.True(TakePresence(proof, ActX()));
  }
}

[Test(PresenceDesk)]
void presence_is_taken_once() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  runas (Ada) {
    var proof = Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", PresenceCodeAhead(key, 1));
    Assert.True(TakePresence(proof, ActX()));
    Assert.False(TakePresence(proof, ActX()));
  }
}

[Test(PresenceDesk)]
void presence_for_another_act_is_refused() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  runas (Ada) {
    var proof = Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", PresenceCodeAhead(key, 1));
    Assert.False(TakePresence(proof, ActY()));
    Assert.True(TakePresence(proof, ActX()));
  }
}

[Test(PresenceDesk)]
void presence_after_five_minutes_is_refused() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  var proof = "";
  runas (Ada) { proof = Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", PresenceCodeAhead(key, 1)); }
  TestClock.Advance(TimeSpan.FromSeconds(301));
  runas (Ada) { Assert.False(TakePresence(proof, ActX())); }
}

[Test(PresenceDesk)]
void password_without_code_refused_when_two_step() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  runas (Ada) {
    Assert.Equal("Type the current code from your authenticator app as well.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", "")).Message);
  }
}

[Test(PresenceDesk)]
void no_passkey_and_no_two_step_gives_no_presence() {
  runas (Bo) {
    Assert.Equal("Add a passkey or two-step sign-in to approve this.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-2", "123456")).Message);
  }
}

[Test(PresenceDesk)]
void another_accounts_proof_is_refused() {
  var key = NewSecondFactorSetup("bo@desk.test").Key;
  PresenceCodesOn("bo@desk.test", "correct-horse-2", key);
  var proof = "";
  runas (Bo) { proof = Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-2", PresenceCodeAhead(key, 1)); }
  runas (Ada) { Assert.False(TakePresence(proof, ActX())); }
  runas (Bo) { Assert.True(TakePresence(proof, ActX())); }
}

[Test(PresenceDesk)]
void a_presence_ceremony_is_never_a_sign_in() {
  var key = WebAuthn.NewTestKey();
  PresenceKeyOn("ada@desk.test", "correct-horse-1", key);
  var handle = PresenceHandleOf("ada@desk.test");
  PasskeyStart start = new PasskeyStart();
  runas (Ada) { start = StartPresence(ActX()); }
  var answer = WebAuthn.TestGet(key, start.Options, PasskeyOrigin(), handle, 1, true);
  runas (AuthBootstrap) {
    Assert.Equal("That passkey sign-in has expired — start again.",
                 Assert.Throws<ValidationException>(() => SignInWithPasskey(start.Token, answer)).Message);
  }
}

[Test(PresenceDesk)]
void a_sign_in_ceremony_is_never_presence() {
  var key = WebAuthn.NewTestKey();
  PresenceKeyOn("ada@desk.test", "correct-horse-1", key);
  var handle = PresenceHandleOf("ada@desk.test");
  // A sign-in's ceremony…
  PasskeyStart signIn = new PasskeyStart();
  runas (AuthBootstrap) { signIn = StartPasskeySignIn(); }
  var answer = WebAuthn.TestGet(key, signIn.Options, PasskeyOrigin(), handle, 1, true);
  runas (Ada) {
    Assert.Equal("That confirmation has expired — start again.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), signIn.Token, answer)).Message);
  }
  // …and Ada's own ADD ceremony, answered as if it asked for a passkey.
  PasskeyStart confirm = new PasskeyStart();
  runas (AuthBootstrap) { confirm = StartPasskeySignIn(); }
  var confirmed = WebAuthn.TestGet(key, confirm.Options, PasskeyOrigin(), handle, 2, true);
  PasskeyAdding adding = new PasskeyAdding();
  runas (AuthBootstrap) { adding = AddPasskey("ada@desk.test", "", "", confirm.Token, confirmed); }
  var forged = WebAuthn.TestGet(key, WebAuthn.RequestOptions(adding.Token, PasskeySite(), []), PasskeyOrigin(), handle, 3, true);
  runas (Ada) {
    Assert.Equal("That confirmation has expired — start again.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), adding.Token, forged)).Message);
  }
}

[Test(PresenceDesk)]
void a_proof_row_written_by_hand_is_refused() {
  runas (Ada) { Assert.Denied(() => HandWrittenPresence(ActX())); }
}

[Test(PresenceDesk)]
void a_recovery_or_texted_code_gives_no_presence() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  var on = PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  runas (Ada) {
    Assert.Equal("That code is not right — type the newest code your app shows.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", on.RecoveryCodes[0])).Message);
  }
  // A code mailed to her address (a step-up's) is not her authenticator's.
  StepUp? s = null;
  runas (Ada) { s = StartStepUp(CodePurpose.PrivacyRequest); Workflow.Settle(StepUp.Single(x => x.Id == s!.Id)); }
  var mailed = "";
  runas (AuthBootstrap) { mailed = CodeIn("ada@desk.test"); }
  runas (Ada) {
    Assert.Equal("That code is not right — type the newest code your app shows.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", mailed)).Message);
  }
  // Cy's texted second step is no presence, whatever code she types.
  runas (Cy) {
    Assert.Equal("Add a passkey or two-step sign-in to approve this.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-3", "123456")).Message);
  }
}

[Test(PresenceDesk)]
void a_passkey_without_user_verification_is_refused() {
  var key = WebAuthn.NewTestKey();
  PresenceKeyOn("ada@desk.test", "correct-horse-1", key);
  var handle = PresenceHandleOf("ada@desk.test");
  runas (Ada) {
    var start = StartPresence(ActX());
    Assert.Contains("\"userVerification\":\"required\"", start.Options);
    Assert.Contains("did not check it was you", Assert.Throws<ValidationException>(() =>
      Osysharp.UserAccounts.ProvePresence(ActX(), start.Token, WebAuthn.TestGet(key, start.Options, PasskeyOrigin(), handle, 1, false))).Message);
  }
}

[Test(PresenceDesk)]
void a_code_used_once_gives_no_second_presence() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  var code = PresenceCodeAhead(key, 1);
  runas (AuthBootstrap) {
    var step = SignIn("ada@desk.test", "correct-horse-1");
    Assert.NotEqual("", SignInWithCode(step.Challenge, code).Ticket);
  }
  runas (Ada) {
    Assert.Equal("That code is not right — type the newest code your app shows.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", code)).Message);
  }
}

[Test(PresenceDesk)]
void failed_presence_counts_toward_the_lockout() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  runas (Ada) {
    for (var i = 0; i < 10; i++) {
      Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", "000000"));
    }
    Assert.Equal("Too many wrong codes — wait fifteen minutes, then try again.",
                 Assert.Throws<ValidationException>(() => Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", PresenceCodeAhead(key, 1))).Message);
  }
}

[Test(PresenceDesk)]
void an_apps_own_prove_presence_writes_no_proof() {
  runas (Ada) { Assert.Denied(() => DeskOwnPresence(ActX())); }
}

/// A wrong-code record written by the desk's own code as the account, past the sign-in's code check and `ProvePresence`.
void HandWrittenMiss() {
  new SecondFactorMiss { Account = Me()!, At = DateTime.UtcNow };
  UnitOfWork.Commit();
}

[Test(PresenceDesk)]
void a_miss_written_by_hand_is_refused() {
  runas (Ada) { Assert.Denied(() => HandWrittenMiss()); }
}

[Test(PresenceDesk)]
void a_password_reset_spends_live_presence() {
  var key = NewSecondFactorSetup("ada@desk.test").Key;
  PresenceCodesOn("ada@desk.test", "correct-horse-1", key);
  var proof = "";
  runas (Ada) { proof = Osysharp.UserAccounts.ProvePresence(ActX(), "", "", "correct-horse-1", PresenceCodeAhead(key, 1)); }
  runas (AuthBootstrap) { RequestPasswordReset("ada@desk.test"); }
  var token = "";
  runas (AuthBootstrap) { token = TokenIn("ada@desk.test", "/reset-password/"); }
  runas (AuthBootstrap) { ResetPassword(token, "a-whole-new-one"); }
  runas (Ada) { Assert.False(TakePresence(proof, ActX())); }
}
