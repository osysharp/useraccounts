// Sign-in only through the provider (OP-IdP1b): an organisation that says "acme.com signs in with Google" means every way
// in — a password, a reset link, a passkey, a texted code, an app's own door — is refused for an acme.com account, and only
// a Google sign-in whose sealed hosted domain is Acme's lets it in.
//
// ⚑ THE WAY IS THIS SIGN-IN'S, NEVER THE LINK'S. What a sign-in came through (`SignInWay`) is read from THIS sign-in's
//   seal — the provider's type and the hosted domain the platform validated and sealed — and kept on the challenge row
//   when a code or an enrolment follows. `UserOAuthLink.HostedDomain` is what the domain was when the link was made, for a
//   page to show; nothing here reads it, so a person who has left Acme's Workspace is not let in by an old link.

namespace Osysharp.UserAccounts;

using Osysharp.Identity;

/// How a sign-in came in: through a provider (its TYPE — "google", "microsoft", "oidc", "github" — and the hosted domain
/// its seal carries), or not through one (both empty: a password, a reset link, a passkey, a texted code, a door code).
/// Not public: only the kit makes one, from a seal (`ProviderWayOf`) or as `NotThroughAProvider`.
class SignInWay {
  public string ProviderType = "";
  public string HostedDomain = "";
  /// The client's NAME as the seal carries it (`org:acme-okta` for an organisation's own client; "" for no provider): a
  /// `client:<key>` rule admits only `org:<key>` (ORGPOL OP-OC1c1-2).
  public string ProviderName = "";
  /// The pending token itself ("" for no provider), so a code step or an enrolment in a LATER request reopens it there
  /// (OP-IdP1b5, review N2): the platform's mint judges only a seal opened in the request that mints.
  public string Seal = "";
  /// The credential id of the passkey THIS sign-in was made with ("" for any other way): set only by `SignInWithPasskey`,
  /// after `WebAuthn.Verify` accepted it, so the override's waiver (`SignInRulePolicy.Waives`) is asked of a proven key.
  public string Passkey = "";
  /// The second step THIS sign-in proved, set by the kit where the step was checked: "app" (an authenticator or recovery
  /// code), "sms" (a texted code, which never meets a requirement), "passkey", "provider" (a counted provider factor), or
  /// "" for none. Never kept on a challenge: a step is proven in the request that mints.
  public string SecondStep = "";
}

/// A sign-in that came through no provider.
SignInWay NotThroughAProvider() { return new SignInWay(); }

/// The way THIS provider sign-in came in, from its seal: the provider's type and the hosted domain the platform sealed
/// ("" for a consumer account, a guest, or a seal that is not good).
SignInWay ProviderWayOf(string pendingToken) {
  return new SignInWay { ProviderType = Security.PendingOAuthProviderType(pendingToken).Trim().ToLower(),
                         HostedDomain = NoTrailingDot(Security.PendingOAuthHostedDomain(pendingToken).Trim().ToLower()),
                         ProviderName = Security.PendingOAuthProvider(pendingToken),
                         Seal = pendingToken };
}

/// The way a sign-in challenge (a code step, an enrolment) was made for: its pending token, REOPENED in this request
/// (OP-IdP1b5, review N2), so the platform validates and judges the seal where the ticket is minted. The token counts only
/// while the platform still opens it (this app's, not expired) and only when it is the challenge's account's own — linked
/// to it, or verified for its address; anything else is a sign-in through no provider.
SignInWay WayOfChallenge(SignInChallenge pending) {
  var kept = pending.PendingToken ?? "";
  if (kept == "") { return NotThroughAProvider(); }
  var token = Crypto.Decrypt(kept);
  var linked = Security.PendingOAuthLinkedUser(token);
  var verified = NormalisedEmail(Security.VerifyPendingOAuthEmail(token));
  var mine = (linked != null && linked.Value == pending.Account.Id) || (verified != "" && verified == pending.Account.Email);
  if (!mine) { return NotThroughAProvider(); }
  return ProviderWayOf(token);
}

/// A challenge row's pending token, as it is kept: sealed under the app's key (`Crypto.Encrypt`, as `TotpSecret` is), so
/// the row — read from a backup or an export — holds no usable token; null for a sign-in through no provider.
string? SealToKeep(SignInWay via) { return via.Seal == "" ? null : Crypto.Encrypt(via.Seal); }

/// Spend a challenge: used now, and its pending token gone (a credential is kept no longer than it is needed).
void SpendChallenge(SignInChallenge pending) {
  pending.UsedAt = DateTime.UtcNow;
  pending.PendingToken = null;
}

/// Drop the pending token of every challenge of `account` that is spent or has lapsed — run when a new one is made.
[SuppressWarning("cost-unbounded-read")]   // one account's challenges that still hold a token — a handful at most
void DropLapsedSeals(User account) {
  var now = DateTime.UtcNow;
  foreach (var old in SignInChallenge.Where(c => c.Account == account && c.PendingToken != null
                                                 && (c.UsedAt != null || c.ExpiresAt < now)).ToList()) {
    old.PendingToken = null;
  }
}

/// The provider an account must sign in through: the provider's type, the domain of the account's address that binds it,
/// and the hosted domains (the organisation's) a sign-in may carry. None (null) for an account no rule binds.
public class ProviderRule {
  public string Provider = "";
  public string Domain = "";
  public List<string> Domains = [];
}

/// Which MORE accounts must sign in through a provider. The app's locked `AccountsSetup.ProviderOnly` (an organisation's
/// lock sets it for its apps) is ALWAYS judged first, whatever this says (OP-IdP1b4b, review M1/D1): an override can only
/// ADD a binding, never lift the organisation's — save for a verified break-glass passkey (`BreakGlassWaivesTheLock`), which the
/// app itself checks, records and tells. An app that binds more — Admin, from the rule of the organisation that
/// owns the address's domain — derives and overrides `ProviderOnly`:
///
///     public class OrgSignIn : SignInRulePolicy {
///       public override ProviderRule? ProviderOnly(User account) { … }
///     }
///     app.Accounts = new AccountsSetup { …, SignInRules = new OrgSignIn() };
///
/// Asked at every ticket the kit issues (`AdmitBy`), as the sign-in flow, for an account the lock does not bind.
public class SignInRulePolicy {
  /// A provider `account` must ALSO sign in through, or null (the default) when only the locked rule binds it.
  public virtual ProviderRule? ProviderOnly(User account) { return null; }
  /// Whether the passkey `passkey` (its credential id, just verified) lets `account` in although THIS override binds it
  /// (OP-IdP1d: Admin's break-glass passkey of an Owner, during the provider's outage). Asked ONLY for a passkey sign-in,
  /// and ONLY when the binding is this override's: the app's locked rule is never waived. False (the default) for every
  /// other app.
  public virtual bool Waives(User account, string passkey) { return false; }
  /// Whether the passkey `passkey` (its credential id, just verified) is a BREAK-GLASS key that lets `account` in although the
  /// app's LOCKED rule binds it (OP-IdP3-O, Revision 2b): the app's own organisation's emergency way in while its provider is down,
  /// which the app checks, records and tells as it decides. Asked ONLY for a passkey sign-in, ONLY when the locked rule binds the
  /// account, and BEFORE that rule is judged; no other way in is ever asked it. False (the default) for every other app.
  public virtual bool BreakGlassWaivesTheLock(User account, string passkey) { return false; }
  /// Whether `account` must ALSO use two-step sign-in (OP-IdP5a: Admin, for the members of an organisation that asks it).
  /// It only adds: the app's `SecondFactorForAll` and `SecondFactor.Required` are asked whatever this says.
  public virtual bool SecondFactorForAll(User account) { return false; }
  /// The most hours a sign-in of `account` may last (1–12). It only lowers: the smaller of this and the app's
  /// `SignInHours` binds, and 12 (the default) adds nothing.
  public virtual int SignInHours(User account) { return 12; }
}

/// The rule `value` (`<provider> <domain>[,<domain>…]`, or `client:<key> <domain>[,…]`) makes for the address `email`: null when the value names no
/// rule, or the address is on none of its domains. An address on a SUBDOMAIN of a listed domain is bound too
/// (`ada@eu.acme.com` by `acme.com`), and one trailing dot is dropped first (`ada@acme.com.` still gets Acme's mail). A
/// value that is not a rule binds nobody HERE — `RefuseOffTheRule` refuses every sign-in under one first (fails closed).
ProviderRule? ProviderRuleIn(string value, string email) {
  if (ProviderOnlyProblem(value) != "" || value.Trim() == "") { return null; }
  var domain = AddressDomain(email);
  if (domain == "") { return null; }
  var text = value.Trim();
  var space = text.IndexOf(" ");
  var domains = ProviderOnlyDomains(text.Substring(space + 1));
  foreach (var listed in domains) {
    if (domain == listed || domain.EndsWith("." + listed)) {
      return new ProviderRule { Provider = text.Substring(0, space).ToLower(), Domain = listed, Domains = domains };
    }
  }
  return null;
}

/// The domain of an address, lower-case, without one trailing dot; "" for an address with none.
string AddressDomain(string email) {
  var at = email.LastIndexOf("@");
  if (at < 0) { return ""; }
  return NoTrailingDot(email.Substring(at + 1).Trim().ToLower());
}

/// `domain` without one trailing dot (`acme.com.` is `acme.com`).
string NoTrailingDot(string domain) {
  if (domain.EndsWith(".")) { return domain.Substring(0, domain.Length - 1); }
  return domain;
}

/// The domains of a rule's list, lower-case: separated by commas (spaces around them are fine).
List<string> ProviderOnlyDomains(string list) {
  List<string> domains = [];
  foreach (var part in list.Split(",")) {
    var d = part.Trim().ToLower();
    if (d != "" && !domains.Contains(d)) { domains.Add(d); }
  }
  return domains;
}

/// What is wrong with `value` as a "Sign-in only through the provider" rule, in a sentence — or "" when it is a rule
/// (or empty: no rule). A provider whose organisation is its own (google, microsoft) or `client:<key>` (the key of one of
/// the organisation's own sign-in clients, ORGPOL OP-OC1c1-2), a space, then one or more domains separated by commas. The
/// organisation's save asks it, so a value that would bind nobody is never stored.
public string ProviderOnlyProblem(string value) {
  var text = value.Trim();
  if (text == "") { return ""; }
  var space = text.IndexOf(" ");
  if (space < 0) {
    return "Write the provider, a space, then the domains it signs in: for example google acme.com,acme.se.";
  }
  var provider = text.Substring(0, space).ToLower();
  // ⚑ NOT oidc: every OpenID Connect issuer is of type oidc and names its own organisations, so a rule on the type would
  //   let one issuer's value pass for another's. Google's and Microsoft's values are theirs alone.
  var named = provider.StartsWith("client:");
  if (named && !Regex.IsMatch(provider.Substring(7), "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$")) {
    return $"'{provider.Substring(7)}' is not a client key: write client: and the key of one of your organisation's sign-in clients, for example client:acme-okta acme.com.";
  }
  if (!named && provider != "google" && provider != "microsoft") {
    return $"'{provider}' is not a provider a rule can name: write google (its Workspace's primary domains), microsoft (its tenant id) or client: and your organisation's sign-in client.";
  }
  var domains = ProviderOnlyDomains(text.Substring(space + 1));
  if (domains.Count == 0) { return "Name at least one domain after the provider, for example google acme.com."; }
  foreach (var d in domains) {
    // Microsoft's organisation is its tenant id (`tid`), so a Microsoft rule lists the tenant beside its domains.
    if (provider == "microsoft" && Regex.IsMatch(d, "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) { continue; }
    if (!Regex.IsMatch(d, "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$")) {
      return $"'{d}' is not a domain. Write domains such as acme.com, separated by commas.";
    }
  }
  return "";
}

/// The name a person knows a provider type by; a `client:<key>` rule's client by its key.
string ProviderTypeName(string provider) {
  if (provider.StartsWith("client:")) { return provider.Substring(7); }
  if (provider == "google") { return "Google"; }
  if (provider == "microsoft") { return "Microsoft"; }
  return "your organisation's sign-in";
}

/// SECURITY-INVARIANT(provider-only-on-every-door): an account a "Sign-in only through the provider" rule binds
/// (`AccountsSetup.SignInRules.ProviderOnly`) is given a ticket only for a sign-in that came through that provider's TYPE
/// with one of the rule's hosted domains in THIS sign-in's seal — the two compared together, so another provider saying
/// the same domain, or the right provider with another organisation (or none: a consumer account, a guest), is refused.
/// Every ticket the kit issues passes here (`AdmitBy`, and the fresh tickets of a changed or removed password), so a
/// password, a reset link, a passkey, a texted code and an app's own door are refused at the same place. The link's
/// stored domain is never read. A `client:<key>` rule (ORGPOL OP-OC1c1-2) admits only a sign-in through the organisation's
/// client `org:<key>` — plus one of the rule's hosted domains when that client is a google kind (Google's issuer is
/// everyone's); the client's registered issuer is judged by the platform where it mints the ticket (`IProviderOnlyRule`),
/// which every ticket the kit issues passes. The LOCKED value is judged first, always; an app's `SignInRules` can only add a binding.
/// A locked value that is not a rule fails CLOSED: every sign-in is refused, with a Warning. Two waivers, each asked only for a
/// verified passkey: the app's BREAK-GLASS waiver of the lock (`SignInRulePolicy.BreakGlassWaivesTheLock`, OP-IdP3-O), asked
/// before the locked value is judged and only when it binds; and the override's own waiver (`SignInRulePolicy.Waives`), asked
/// only of a binding the override added (OP-IdP1d). Nothing else reaches the locked value. Guarded by
/// tests/provider-only.test.osy (`the_lock_beats_a_break_glass_passkey`, `a_password_is_never_waived`) and, for the
/// break-glass waiver, Platform.Tests OwnerSignInHoldsTests (`the_glass_passkey_passes_a_locked_rule`,
/// `owner_password_and_github_stay_refused`, `glass_for_an_org_out_of_scope_is_refused`).
void RefuseOffTheRule(User account, SignInWay via) {
  var setup = App.Setting<AccountsSetup>();
  if (ProviderOnlyProblem(setup.ProviderOnly) != "") {
    Log.Warning("Sign-in: the locked rule AccountsSetup.ProviderOnly is not a rule this kit can read; every sign-in is refused");
    throw new ValidationException("Signing in is not possible here right now. Contact your administrator.");
  }
  var locked = ProviderRuleIn(setup.ProviderOnly, account.Email);
  // The break-glass waiver of the lock, asked BEFORE the lock is judged: only a verified passkey, only when the lock binds.
  if (locked != null && via.Passkey != "" && setup.SignInRules.BreakGlassWaivesTheLock(account, via.Passkey)) { return; }
  var rule = locked ?? setup.SignInRules.ProviderOnly(account);
  if (rule == null) { return; }
  if (CameThrough(rule!, via)) { return; }
  if (locked == null && via.Passkey != "" && setup.SignInRules.Waives(account, via.Passkey)) { return; }
  throw new ValidationException($"{rule!.Domain} accounts sign in with {ProviderTypeName(rule!.Provider)}.");
}

/// Did a sign-in that came in `via` come through what `rule` names: its provider's TYPE with one of its hosted domains in
/// THIS sign-in's seal, or, for a `client:<key>` rule, the organisation's client `org:<key>` (with one of its hosted domains
/// when that client is a google kind)?
bool CameThrough(ProviderRule rule, SignInWay via) {
  if (rule.Provider.StartsWith("client:")) {
    return via.ProviderName == "org:" + rule.Provider.Substring(7)
        && (via.ProviderType != "google" || (via.HostedDomain != "" && rule.Domains.Contains(via.HostedDomain)));
  }
  return via.ProviderType == rule.Provider && via.HostedDomain != "" && rule.Domains.Contains(via.HostedDomain);
}

/// SECURITY-INVARIANT(provider-factor-counts-only-when-pinned): the provider's own second factor stands in for the kit's only
/// when the app's `ProviderFactorCounts` says so, a rule binds the account (the lock, else the app's `SignInRules`) and THIS
/// sign-in came through it (never by a waiver), and the platform judges the sealed factor fresh and of the organisation's pin
/// (its own sign-in client, or a Microsoft tenant its rule lists), never Google's (`Security.PendingOAuthSecondFactor`). An
/// account no rule binds, a sign-in that did not pass the rule, and a Google one are asked for the kit's own step. Guarded by
/// Platform.Tests' KitProviderFactorTests (`pinned_entra_mfa_counts_when_allowed`, `google_never_satisfies_the_factor`,
/// `entra_mfa_ignored_when_not_allowed`, `unbound_entra_mfa_does_not_count`).
bool ProviderFactorCountsFor(User account, SignInWay via) {
  var setup = App.Setting<AccountsSetup>();
  if (!setup.ProviderFactorCounts || via.Seal == "") { return false; }
  var rule = ProviderRuleIn(setup.ProviderOnly, account.Email) ?? setup.SignInRules.ProviderOnly(account);
  if (rule == null || !CameThrough(rule!, via)) { return false; }
  return Security.PendingOAuthSecondFactor(via.Seal);
}
