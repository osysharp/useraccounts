// A phone number on an account, FOR one of two things (owner, 15 Nov: "to contact a person, any number is fine; to send
// information as text, it needs to be a cell number"):
//   • CALLS — any number, a landline too. Recorded once the person confirms it is them; no code, and NOTHING IS EVER
//     TEXTED TO IT: it signs nobody in, is nobody's second step, and costs the app nothing.
//   • TEXTS — a mobile, proven by a six-digit code texted to it: it is a number for texts only once that code came back.
//     Then — when the app offers it — a way to sign in with a texted code, or an account's own choice of second step, and
//     where the app texts the account (`NumberToText`).
// Stored as `User.Phone` with `PhoneVerifiedAt` set for a number for texts (its code came back), and null for a number for
// calls — so every number recorded before purposes existed (each proven by its code) is a number for texts, as it was.
// Texts go through Osysharp.Sms, so an app with no text-message sender yet still works: the codes wait in the outbox.
//
// ⚑ THE APP DECIDES WHAT A NUMBER FOR TEXTS IS FOR (`AccountsSetup.ProvePhones`, `SmsSignIn`, `SmsSecondStep`), all off by
//   default: a texted code is cheap for an attacker who has taken over a number (a SIM swap, a port-out), so a number never
//   signs anybody in unless the app chose that. And it is NEVER the second factor an app can REQUIRE —
//   `SecondFactor.Required` always means an authenticator app (SECURITY-INVARIANT accounts-sms-is-not-a-required-second-factor, SignIn.osy).
//
// ⚑ "MUST BE A MOBILE" IS CHECKED BY THE CODE. A number that cannot receive a text cannot send the code back; there is no
//   table of mobile ranges to get wrong (numbers move between operators, and every country draws its ranges its own way).

namespace Osysharp.UserAccounts;

using Osysharp.Identity;
using Osysharp.Sms;

/// Add, change or remove the account's phone number, given its address and password — and say what it is for.
///
/// For texts (`forTexts`, the default): with a `phone` and no `code`, a code is texted to it and this answers "sent"; with
/// the code, the number is recorded as the account's number for texts and this answers "". With two-step sign-in on,
/// recording it also takes a current code from the authenticator (`twoStepCode`). Only an account the app offers texts to
/// (`AccountsSetup.Phone.ForTexts`) may; until the code comes back, the account's number — and what it is for — is what
/// it was, so a number for calls being moved to texts is still not texted anything but its code.
///
/// For calls (`forTexts: false`): any number, a landline too — recorded at once, nothing texted, answers "". Any account
/// may, whenever the app keeps numbers. With two-step sign-in on, it takes the authenticator's code as well. A number for
/// texts made a number for calls is never texted again.
///
/// An empty `phone` removes the number. Changing or removing it is refused while it is the account's texted second step
/// (turn that off first). Throws the sentence to show.
[AuthMethod]
public string ProvePhone(string email, string password, string phone, string code = "", string twoStepCode = "",
                         bool forTexts = true) {
  var setup = App.Setting<AccountsSetup>();
  if (!PhonesOffered()) { throw new ValidationException($"{AccountsAppName()} does not keep phone numbers."); }
  var account = Verified(email, password);
  RefuseWhileTheNumberIsTheStep(account);
  if (phone.Trim() == "") {
    if (account.TotpSecret != null) { RequireCode(account, twoStepCode); }
    if (account.Phone != null) {
      var old = account.Phone;
      account.Phone = null;
      account.PhoneVerifiedAt = null;
      SendRendered(account.Email, setup.Mails.PhoneChanged(account, old, false));
    }
    return "";
  }
  if (!forTexts) {
    var number = KeptNumber(phone);
    if (account.TotpSecret != null) { RequireCode(account, twoStepCode); }
    if (account.Phone == number && account.PhoneVerifiedAt == null) { return ""; }
    // Nothing is texted: a number for calls is recorded as it stands, and from now on nothing texts it (`NumberToText`).
    account.Phone = number;
    account.PhoneVerifiedAt = null;
    SendRendered(account.Email, setup.Mails.PhoneChanged(account, number, true));
    return "";
  }
  // SECURITY-INVARIANT(accounts-a-phone-is-added-only-where-the-app-offers-one): a number FOR TEXTS is added on the account
  // page only for an account the app's `AccountsSetup.Phone.ForTexts` offers texts to — every one costs a text; a number
  // for calls costs none and any account may keep one. Guarded by tests/sms.test.osy
  // (an_account_the_app_offers_no_phone_cannot_add_one_but_may_remove_its_own).
  if (!setup.Phone.ForTexts(account)) {
    throw new ValidationException($"{AccountsAppName()} does not send texts to your account — add the number for calls instead.");
  }
  if (code.Trim() == "") {
    TextPhoneCode(account, phone);
    return "sent";
  }
  if (account.TotpSecret != null) { RequireCode(account, twoStepCode); }
  ProvePhoneCode(account, phone, code);
  return "";
}

/// Text `account` a code that proves `phone`, and answer the number as the kit keeps it (E.164) — for an app's own door:
/// an `[AuthMethod]` that has established who this is in its own way (a provider's sealed sign-in, an application it is
/// completing) and must prove a number for that account, where `ProvePhone` would ask for a password the account may not
/// have. Texted within the same limits as every code (`TextCode`). Throws the sentence to show for a number
/// with no country code. A number other accounts have proven too is fine — one phone may serve several accounts.
public string TextPhoneCode(User account, string phone) {
  var number = KeptNumber(phone);
  TextCode(account, CodePurpose.ProvePhone, number);
  return number;
}

/// Record `phone` as `account`'s number for texts, proven by the `code` that `TextPhoneCode` (or `ProvePhone`) texted to it — the other half
/// of an app's own door. A wrong or spent code is a wrong try against the account, kept, and the sentence thrown; a right
/// one records the number and tells the account's address. Only a code texted for THIS account proves it: a code texted
/// to the same number for another account is not one of this account's codes.
public void ProvePhoneCode(User account, string phone, string code) {
  RefuseWhileTheNumberIsTheStep(account);
  var number = KeptNumber(phone);
  var match = CodeMatching(LiveCodesOf(account, CodePurpose.ProvePhone, number), code);
  if (match == null) {
    UnitOfWork.Commit();   // the miss is kept: the throw below would discard it
    throw new ValidationException(WrongCode());
  }
  account.Phone = number;
  account.PhoneVerifiedAt = DateTime.UtcNow;
  SendRendered(account.Email, App.Setting<AccountsSetup>().Mails.PhoneChanged(account, number, true));
}

/// Throws the sentence to show when `account`'s number is its texted second step: that number is a factor, and moves only
/// once the step is off — which asks for a code texted to it (SECURITY-INVARIANT accounts-a-factor-is-added-only-past-a-factor).
void RefuseWhileTheNumberIsTheStep(User account) {
  if (account.SmsSecondStep) { throw new ValidationException("Turn off text-message sign-in codes first — this number is your second step."); }
}

/// `phone` as the kit keeps it (E.164), for a number of either purpose, when the app keeps numbers — or the sentence to
/// show, thrown.
///
/// ⚑ A NUMBER MAY BE PROVEN BY SEVERAL ACCOUNTS — people may keep more than one. Each proves
///   it with a code texted for that account alone (`LiveCodesOf` reads only the account's own codes), so proving it for
///   one account says nothing about another, and its second step and contact use are each account's own. Where a number
///   IDENTIFIES an account — signing in by text — a shared one identifies nobody (`SignInWithPhone`).
string KeptNumber(string phone) {
  if (!PhonesOffered()) { throw new ValidationException($"{AccountsAppName()} does not keep phone numbers."); }
  var number = NormalisedPhone(phone);
  if (number == "") {
    throw new ValidationException("Write the number with a + and its country code — +46 70 123 45 67, not 070 123 45 67.");
  }
  return number;
}

/// Obsolete since 1.7.0 — use `KeptNumber(phone)`; the account plays no part in keeping a number. Kept so code written
/// against 1.5 still compiles, and answers what that did: `phone` as the kit keeps it, or the sentence to show, thrown.
string NumberThisAccountMayProve(User account, string phone) { return KeptNumber(phone); }

/// Where `account` may be texted: its number when that is a number for texts whose code came back — else "". The ONE
/// answer to "may this account be texted, and where": every text the kit sends an account (a sign-in code, a texted
/// second step, "use your password") takes its number from here, and an app texting its people (an alert to staff)
/// should too. A number for calls answers "".
///
/// SECURITY-INVARIANT(accounts-only-a-confirmed-number-for-texts-is-texted): nothing is texted to an account's number
/// unless it is a number for texts whose code came back. Every reader that texts an account goes through this, and
/// `TextCode` refuses any code but the confirming one to a number this does not answer. The confirming code is the one
/// text an unconfirmed number gets — only when its own account asks to use it for texts, within `TextCode`'s limits.
/// Guarded by tests/sms.test.osy (a_texts_number_is_used_only_after_its_code_is_confirmed — red with this check removed).
public string NumberToText(User account) {
  if (account.Phone == null || account.PhoneVerifiedAt == null) { return ""; }
  return account.Phone;
}

/// The accounts a texted code to `number` could sign in: active, the number theirs for texts (`NumberToText`), and not one
/// whose second step is this very phone (one phone is one factor). A number for calls signs nobody in.
[SuppressWarning("cost-unbounded-read")]   // the accounts behind one phone number — a handful at most
List<User> SignInHoldersOf(string number) {
  if (number == "") { return new List<User>(); }
  return User.Where(u => u.Phone == number && u.IsActive).ToList()
    .Where(u => NumberToText(u) == number && !TextedSecondStep(u)).ToList();
}

/// An account behind `number` whose second step is that phone, or null.
[SuppressWarning("cost-unbounded-read")]   // the accounts behind one phone number — a handful at most
User? SecondStepHolderOf(string number) {
  if (number == "") { return null; }
  return User.Where(u => u.Phone == number && u.IsActive).ToList()
    .Where(u => NumberToText(u) == number && TextedSecondStep(u)).FirstOrDefault();
}

/// Text `text` to `number` unless it was already texted there in the last hour — the same bound on a stranger's phone as
/// the codes have.
void TextOnceAnHour(string number, string text) {
  var anHourAgo = DateTime.UtcNow - TimeSpan.FromHours(1);
  if (!OutgoingSms.Any(m => m.To == number && m.Text == text && m.CreatedAt > anHourAgo)) {
    SendSms(new SmsMessage { To = number, Text = text });
  }
}

/// Sign in with a code texted to a proven number, in place of the password — when the app offers it (`SmsSignIn`). With no
/// `code`, a code is texted if the number belongs to an account that may sign in this way, and the answer is `CodeSent`
/// either way, so it says nothing about which numbers have accounts. With the code, answers the step that follows, as a
/// password would: a ticket, an authenticator's code, or setting one up. Throws the sentence to show for a wrong code.
///
/// ⚑ AN ACCOUNT WHOSE SECOND STEP IS THIS PHONE IS NOT SIGNED IN BY IT ALONE: one phone is one factor. It is texted how to
///   sign in instead (`AccountTexts.UsePasswordToSignIn`), and a code is never issued for it.
///
/// SECURITY-INVARIANT(accounts-a-shared-number-signs-in-no-one-by-itself): a number more than one account could sign in
/// with identifies none of them, so it signs in nobody — no code is issued for it, the phone is texted to sign in with an
/// address and password instead (`AccountTexts.UsePasswordOnASharedNumber`), and the caller is answered exactly as for
/// any other number. A code issued before the number became shared is refused when typed. Never "the first account with
/// that number": that is an arbitrary account, chosen by row order. Guarded by tests/sms.test.osy
/// (a_number_two_accounts_share_is_proven_by_each_and_signs_in_neither).
[AuthMethod]
public SignInStep SignInWithPhone(string phone, string code = "") {
  if (!App.Setting<AccountsSetup>().SmsSignIn) { throw new ValidationException($"{AccountsAppName()} does not sign people in by text message."); }
  var number = NormalisedPhone(phone);
  var holders = SignInHoldersOf(number);
  if (code.Trim() == "") {
    var texts = App.Setting<AccountsSetup>().Texts;
    if (holders.Count == 1) {
      TextCode(holders[0], CodePurpose.SignIn, number);
    } else if (holders.Count > 1) {
      TextOnceAnHour(number, texts.UsePasswordOnASharedNumber());
    } else {
      var stepHolder = SecondStepHolderOf(number);
      if (stepHolder != null) { TextOnceAnHour(number, texts.UsePasswordToSignIn(stepHolder)); }
    }
    return new SignInStep { CodeSent = true, Account = number == "" ? "" : MaskedPhone(number) };
  }
  var match = number == "" ? null : CodeMatching(LiveCodes(CodePurpose.SignIn, number), code);
  if (match == null || !match.Account.IsActive || TextedSecondStep(match.Account)
      || holders.Count != 1 || holders[0].Id != match.Account.Id) {
    UnitOfWork.Commit();   // the miss is kept: the throw below would discard it
    throw new ValidationException(WrongCode());
  }
  return ContinueSignIn(match.Account);
}

/// Turn a texted code on or off as the account's second step — when the app offers it (`SmsSecondStep`). On: the address,
/// the password and a proven number. Off: the same and a code texted to that number — a password alone must never remove
/// a second step — so with no `code` one is texted and this answers "sent". Answers "", or throws the sentence to show.
///
/// ⚠ A CHOICE, NOT A REQUIREMENT: an app that requires a second factor of an account still asks it for an authenticator
///   app, texted step or not.
[AuthMethod]
public string SetSmsSecondStep(string email, string password, bool on, string code = "") {
  var setup = App.Setting<AccountsSetup>();
  if (!setup.SmsSecondStep) { throw new ValidationException($"{AccountsAppName()} does not offer text-message sign-in codes."); }
  var account = Verified(email, password);
  if (on) {
    if (NumberToText(account) == "") { throw new ValidationException("Add a number for texts and confirm it first."); }
    if (account.TotpSecret != null) {
      throw new ValidationException("Two-step sign-in with an authenticator app is on — that is already a stronger second step.");
    }
    if (!account.SmsSecondStep) {
      // The password proves an account with no factor; one that holds a passkey is asked for it
      // (SECURITY-INVARIANT accounts-a-factor-is-added-only-past-a-factor).
      ProvenPastAFactor(email, password, "", "", "");
      account.SmsSecondStep = true;
      SendRendered(account.Email, setup.Mails.TextedStepChanged(account, true));
    }
    return "";
  }
  if (!account.SmsSecondStep) { return ""; }
  if (code.Trim() == "") {
    TextCode(account, CodePurpose.SecondStepOff, NumberToText(account));
    return "sent";
  }
  var match = CodeMatching(LiveCodesOf(account, CodePurpose.SecondStepOff, NumberToText(account)), code);
  if (match == null) {
    UnitOfWork.Commit();
    throw new ValidationException(WrongCode());
  }
  account.SmsSecondStep = false;
  SendRendered(account.Email, setup.Mails.TextedStepChanged(account, false));
  return "";
}

/// Does the app keep phone numbers on accounts at all?
public bool PhonesOffered() {
  var setup = App.Setting<AccountsSetup>();
  return setup.ProvePhones || setup.SmsSignIn || setup.SmsSecondStep;
}

/// What a phone number on an account is for — the account page's choice. Not stored: a number for texts is one whose
/// code came back (`NumberToText`).
public enum PhoneUse {
  [Label("Calls — any number, a landline too. Never texted.")] Calls,
  [Label("Texts — a mobile. We text it a code to confirm it.")] Texts,
}

/// What the account page shows about the signed-in account's phone. Runs as the account itself.
public class PhoneFacts {
  public string Number = "";
  /// The number is for texts and its code came back — the only kind anything is texted to. False: a number for calls.
  public bool Proven = false;
  public bool SecondStep = false;
  /// The account may add (or change to) a number here — one for calls, whenever the app keeps numbers.
  public bool MayAdd = false;
  /// …and one for texts — the app's `AccountsSetup.Phone.ForTexts` offers it texts.
  public bool MayText = false;
}

public PhoneFacts MyPhone() {
  var me = Me();
  if (me == null) { return new PhoneFacts(); }
  var mayAdd = PhonesOffered();
  var mayText = mayAdd && App.Setting<AccountsSetup>().Phone.ForTexts(me);
  if (me.Phone == null) { return new PhoneFacts { MayAdd = mayAdd, MayText = mayText }; }
  return new PhoneFacts { Number = me.Phone, Proven = NumberToText(me) != "", SecondStep = me.SmsSecondStep, MayAdd = mayAdd,
                          MayText = mayText };
}
