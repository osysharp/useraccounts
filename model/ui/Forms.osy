// The forms — each a `[Composable]` an app can put on a page of its own, in any frame. Every colour, face and size is a
// theme token, so an app's theme dresses them; the pages beside this file are these forms in a plain centred frame.

namespace Osysharp.UserAccounts;

using Osysharp.Ui;

/// The app's mark above every sign-in screen's heading: its logo (`AccountsSetup.LogoUrl`, or `logo` here) and its
/// name. The setting puts the mark on every one of the kit's screens without taking a page over; an app page that
/// frames a form itself passes `logo`.
[Composable]
public component AccountsBrand(string logo = "") {
  AccountsFacts facts = new AccountsFacts();
  on mount { facts = AccountsPageFacts(); }
  render {
    Stack(gap: 2, align: Align.Start) {
      if (logo != "" || facts.LogoUrl != "") {
        Image(logo != "" ? logo : facts.LogoUrl, alt: facts.AppName, h: "2.5rem", w: "auto", maxW: "12rem");
      }
      Text(facts.AppName, fontFamily: Font.Display, fontSize: FontSize.Label, fontWeight: FontWeight.Semibold,
           color: Colors.Primary, letterSpacing: "0.04em");
    }
  }
}

/// A narrow centred column for the sign-in screens: the app's mark (`AccountsBrand` — its logo when it has one, and its
/// name), a heading, a line under it, and the form. `logo` overrides `AccountsSetup.LogoUrl` for this frame.
[Composable]
public component AccountsFrame(string heading, string sub = "", string logo = "") {
  render {
    Row(align: Align.Center, justify: Justify.Center, minH: "100dvh", p: 4, bg: Colors.Bg, color: Colors.OnBg) {
      Stack(gap: 4, w: "100%", maxW: "26rem") {
        Stack(gap: 1) {
          AccountsBrand(logo);
          Text(heading, fontFamily: Font.Display, fontSize: FontSize.Title, fontWeight: FontWeight.Bold, lineHeight: "1.15");
          if (sub != "") { Text(sub, color: Colors.TextMuted); }
        }
        Card() { Slot; }
      }
    }
  }
}

/// Sign in — the password, then, for an account with two-step sign-in, a code; or, for an account the app requires it
/// of and that has not set it up, setting it up (an authenticator app, or a passkey). Or a passkey, which is both steps
/// at once and needs no address typed. `then` is where to go afterwards when the visitor was not on their way
/// somewhere. `email` and `password` prefill the fields (a demo's working account, say).
[Composable]
public component SignInForm(string then = "", string email = "", string password = "") {
  AccountsFacts facts = new AccountsFacts();
  // Whether this browser can use passkeys at all — the passkey buttons show only where they can work.
  bool passkeys = false;
  on mount { facts = AccountsPageFacts(); passkeys = Passkey.Supported(); }
  string address = email;
  string secret = password;
  string problem = "";
  string challenge = "";
  string code = "";
  bool enrolling = false;

  string enrolment = "";
  string challengeBy = "";
  string texted = "";
  bool proving = false;
  bool byText = false;
  string phone = "";
  bool codeSent = false;

  action Submit() {
    problem = "";
    try { Take(SignIn(address, secret)); }
    catch (Exception ex) { problem = ex.Message; }
  }

  /// Whatever a sign-in answered: in, a code next, setting two-step sign-in up, or proving the address first.
  action Take(SignInStep step) {
    if (step.Ticket != "") { Session.SignIn(step.Ticket, then != "" ? then : facts.HomePath); return; }
    if (step.MustEnrol) { enrolment = step.Enrolment; address = step.Account; enrolling = true; return; }
    if (step.MustVerify) { proving = true; return; }
    if (step.Challenge != "") { challenge = step.Challenge; challengeBy = step.ChallengeBy; texted = step.Account; code = ""; return; }
    problem = "That address and password do not match an account.";
  }

  action SendText() {
    problem = "";
    try { var step = SignInWithPhone(phone); codeSent = step.CodeSent; code = ""; }
    catch (Exception ex) { problem = ex.Message; }
  }

  action SubmitTextedCode() {
    problem = "";
    try { Take(SignInWithPhone(phone, code)); }
    catch (Exception ex) { problem = ex.Message; code = ""; }
  }

  action UseText() { problem = ""; byText = true; codeSent = false; code = ""; }

  /// A passkey: the browser offers the ones it holds for this app, the device checks it is the person, and that is the
  /// whole sign-in. A closed prompt is nothing happening, said nowhere.
  action SignInWithAPasskey() {
    problem = "";
    try {
      var start = StartPasskeySignIn();
      var answer = Passkey.Get(start.Options);
      if (answer == "") { return; }
      Take(SignInWithPasskey(start.Token, answer));
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  /// Setting a passkey up in place of an authenticator app, for an account that must have a second step: the passkey IS
  /// that step, so keeping it signs the person in.
  action EnrolAPasskey() {
    problem = "";
    try {
      var first = AddPasskey("", "", "", "", "", enrolment);
      var made = Passkey.Create(first.Options);
      if (made == "") { return; }
      var done = AddPasskey("", "", "", "", "", enrolment, first.Token, made, "Passkey");
      Session.SignIn(done.Ticket, then != "" ? then : facts.HomePath);
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  action ContinueWith(string provider) { Navigation.Open(ProviderSignInAddress(provider), sameTab: true); }

  action SubmitCode() {
    problem = "";
    try {
      var ticket = SignInWithCode(challenge, code);
      if (ticket == "") { problem = "That code is not right — type the newest one your app shows."; code = ""; return; }
      Session.SignIn(ticket, then != "" ? then : facts.HomePath);
    }
    catch (Exception ex) { problem = ex.Message; challenge = ""; secret = ""; }
  }

  action StartAgain() {
    problem = ""; challenge = ""; code = ""; secret = ""; enrolling = false; enrolment = ""; proving = false;
    byText = false; codeSent = false; challengeBy = "";
  }

  render {
    Stack(gap: 3) {
      if (enrolling) {
        Alert($"{facts.AppName} asks for two-step sign-in on your account. Set it up now — it takes a minute.", tone: Tone.Default);
        SecondFactorEnrolment(address, "", then != "" ? then : facts.HomePath, enrolment: enrolment);
        if (passkeys) {
          Text("Or use a passkey — your phone, laptop or a security key signs you in, with no code to type.", color: Colors.TextMuted);
          Button("Set up a passkey instead", onPress: EnrolAPasskey, size: Size.Lg);
        }
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Back to sign in", onPress: StartAgain, tone: Tone.Ghost);
      } else if (proving) {
        // The password the sign-in just verified goes with the code — so its owner is not asked for it again.
        AddressCodeStep(address, then != "" ? then : facts.HomePath, password: secret);
        Button("Back to sign in", onPress: StartAgain, tone: Tone.Ghost);
      } else if (challenge != "") {
        if (challengeBy == "sms") {
          Text($"We have texted a six-digit code to your phone ({texted}). Type it here — it works for fifteen minutes.", color: Colors.TextMuted);
          Field("Code", value: code, placeholder: "123 456", onEnter: SubmitCode);
        } else {
          Text("Open your authenticator app and type the six-digit code it shows for this account.", color: Colors.TextMuted);
          Field("Code", value: code, placeholder: "123 456", onEnter: SubmitCode,
                hint: "Lost your phone? Type one of your recovery codes instead.");
        }
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Continue", onPress: SubmitCode, tone: Tone.Primary, size: Size.Lg);
        Button("Start again", onPress: StartAgain, tone: Tone.Ghost);
      } else if (byText) {
        Field("Phone number", value: phone, type: "tel", placeholder: "+46 70 123 45 67", onEnter: SendText,
              hint: "The number on your account, with its country code.");
        if (codeSent) {
          Text("If that number may sign in here, a six-digit code is on its way. It works for fifteen minutes.", color: Colors.TextMuted);
          Field("Code from the text", value: code, placeholder: "123 456", onEnter: SubmitTextedCode);
        }
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        if (codeSent) { Button("Sign in", onPress: SubmitTextedCode, tone: Tone.Primary, size: Size.Lg); }
        else { Button("Text me a code", onPress: SendText, tone: Tone.Primary, size: Size.Lg); }
        Button("Sign in with a password instead", onPress: StartAgain, tone: Tone.Ghost);
      } else {
        Field("Email", value: address, type: "email", placeholder: "you@example.com", onEnter: Submit);
        Field("Password", value: secret, type: "password", onEnter: Submit);
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Sign in", onPress: Submit, tone: Tone.Primary, size: Size.Lg);
        if (passkeys) { Button("Sign in with a passkey", onPress: SignInWithAPasskey, size: Size.Lg); }
        if (facts.Providers.Count > 0) {
          Stack(gap: 2) {
            Text("or", color: Colors.TextMuted, fontSize: FontSize.Label, textAlign: TextAlign.Center);
            foreach (var p in facts.Providers) {
              Button($"Continue with {p}", onPress: () => ContinueWith(p), size: Size.Lg) { Icon(MarkOf(facts.Marks, p), size: 18); }
            }
          }
        }
        if (facts.SmsSignIn) { Button("Sign in with a text message", onPress: UseText, tone: Tone.Ghost); }
        Row(gap: 4, wrap: Wrapping.Wrap) {
          if (facts.SignupOpen) { TextLink("Create an account", to: "/sign-up"); }
          TextLink("Forgot your password?", to: "/forgot-password", tone: Tone.Default);
        }
      }
    }
  }
}

/// Setting up two-step sign-in: the QR code and the key for an authenticator app, a first code to prove the app took it,
/// and then the recovery codes — shown once. Signs in (to `then`) when the person has saved them. `email` and `password`
/// are the account's: this runs as the sign-in flow, which proves who is asking by them — or, straight after a sign-in
/// that answered `MustEnrol`, by its `enrolment` token instead of the password.
[Composable]
public component SecondFactorEnrolment(string email, string password, string then, string enrolment = "") {
  SecondFactorSetup setup = new SecondFactorSetup();
  string code = "";
  string problem = "";
  string ticket = "";
  List<string> codes = [];

  on mount { setup = NewSecondFactorSetup(email); }

  action Confirm() {
    problem = "";
    try {
      var on = EnableSecondFactor(email, password, setup.Key, code, enrolment);
      codes = on.RecoveryCodes;
      ticket = on.Ticket;
    }
    catch (Exception ex) { problem = ex.Message; code = ""; }
  }

  action Done() { Session.SignIn(ticket, then); }

  render {
    Stack(gap: 3) {
      if (codes.Count == 0) {
        Text("1. Scan this with an authenticator app — Google Authenticator, Microsoft Authenticator, 1Password, or any other.");
        if (setup.Qr.Count > 0) { QrCode(setup.Qr, label: "QR code for your authenticator app"); }
        Stack(gap: 1) {
          Text("Or type this key into the app:", fontSize: FontSize.Label, color: Colors.TextMuted);
          Text(KeyInGroups(setup.Key), fontFamily: Font.Mono, fontWeight: FontWeight.Semibold, letterSpacing: "0.04em");
        }
        Text("2. Type the six-digit code the app now shows.");
        Field("Code from the app", value: code, placeholder: "123 456", onEnter: Confirm);
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Turn on two-step sign-in", onPress: Confirm, tone: Tone.Primary, size: Size.Lg);
      } else {
        Alert("Two-step sign-in is on.", tone: Tone.Success);
        RecoveryCodeList(codes);
        Button("I have saved them — continue", onPress: Done, tone: Tone.Primary, size: Size.Lg);
      }
    }
  }
}

/// A fresh set of recovery codes, and what they are for. They are shown once: only their fingerprints are kept.
[Composable]
public component RecoveryCodeList(List<string> codes) {
  render {
    Stack(gap: 2) {
      Text("Your recovery codes", fontWeight: FontWeight.Semibold);
      Text("If you lose your phone, each of these signs you in once. Save them somewhere safe — a password manager, or on paper. This is the only time they are shown.",
           color: Colors.TextMuted);
      Box(bg: Colors.Muted, rounded: Radius.Md, p: 3) {
        Stack(gap: 1) {
          foreach (var c in codes) { Text(c, fontFamily: Font.Mono, letterSpacing: "0.06em"); }
        }
      }
    }
  }
}

/// A key in groups of four, as it is easiest to read off a screen and type (the app ignores the spaces).
string KeyInGroups(string key) {
  var groups = new List<string>();
  var i = 0;
  while (i < key.Length) {
    groups.Add(key.Substring(i, Math.Min(4, key.Length - i)));
    i = i + 4;
  }
  return string.Join(" ", groups);
}

/// Make an account — and be signed in to it. When sign-up is closed it says so instead.
[Composable]
public component SignUpForm(string then = "") {
  AccountsFacts facts = new AccountsFacts();
  on mount { facts = AccountsPageFacts(); }
  string name = "";
  string email = "";
  string password = "";
  string problem = "";
  bool enrolling = false;
  string enrolment = "";
  bool proving = false;
  string challenge = "";

  action Submit() {
    problem = "";
    try {
      var step = SignUp(email, password, name);
      if (step.MustEnrol) { enrolment = step.Enrolment; enrolling = true; return; }
      // The same answer for a new address and a taken one: the mail says which.
      if (step.MustVerify) { email = step.Account; proving = true; return; }
      // The address and password of an existing account: its owner, signed in as a sign-in would — a code may be next.
      if (step.Challenge != "") { challenge = step.Challenge; return; }
      Session.SignIn(step.Ticket, then != "" ? then : facts.HomePath);
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 3) {
      if (enrolling) {
        Alert($"Your account is made. {facts.AppName} asks for two-step sign-in on it — set it up now, and you are in.", tone: Tone.Default);
        SecondFactorEnrolment(email, "", then != "" ? then : facts.HomePath, enrolment: enrolment);
      } else if (proving) {
        // The password just chosen goes with the code: the person who signed up is not asked for it twice.
        AddressCodeStep(email, then != "" ? then : facts.HomePath, password: password);
      } else if (challenge != "") {
        SecondFactorCodeStep(challenge, then != "" ? then : facts.HomePath);
      } else if (!facts.SignupOpen) {
        Alert($"{facts.AppName} is not open for sign-up. Ask the person who runs it for an account.", tone: Tone.Default);
        TextLink("I have an account — sign in", to: "/login");
      } else {
        Field("Your name", value: name, placeholder: "How colleagues see you");
        Field("Email", value: email, type: "email", placeholder: "you@example.com");
        Field("Password", value: password, type: "password", onEnter: Submit,
              hint: $"At least {facts.MinPasswordLength} characters.");
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Create account", onPress: Submit, tone: Tone.Primary, size: Size.Lg);
        TextLink("I already have an account", to: "/login");
      }
    }
  }
}

/// Proving an address with the code its mail carried — what sign-up and sign-in show when the app requires a proven address.
/// Says the same whether or not the address has an account: the mail says which (a code, or "you already have an account").
/// Then whatever a sign-in answers next — in, a code from an authenticator, or setting one up. `password` is the one the
/// sign-up or sign-in screen just took: it goes with the code, so the account's first proof (which needs it — see
/// `VerifyEmailCode`) does not ask for it again. Without it, the first proof asks for it or for a new one.
[Composable]
public component AddressCodeStep(string address, string then, string password = "") {
  string code = "";
  string problem = "";
  SignInStep next = new SignInStep();
  bool resent = false;
  /// The carrier's word that mail to the address did not arrive (it bounced, was marked as spam, or is held back) —
  /// asked when the step opens and again while it waits, because the report comes seconds after the send.
  string undelivered = "";

  on mount { undelivered = AddressMailProblems([address])[0]; }

  on every (TimeSpan.FromSeconds(10)) {
    if (!next.MustConfirmPassword && !next.MustEnrol && next.Challenge == "") { undelivered = AddressMailProblems([address])[0]; }
  }

  action Confirm() {
    problem = "";
    try {
      next = VerifyEmailCode(address, code, password);
      if (next.Ticket != "") { Session.SignIn(next.Ticket, then); }
    }
    catch (Exception ex) { problem = ex.Message; code = ""; }
  }

  action Resend() { RequestVerification(address); resent = true; undelivered = AddressMailProblems([address])[0]; }

  render {
    Stack(gap: 3) {
      if (next.MustConfirmPassword) {
        ConfirmPasswordStep("", address, code, then);
      } else if (next.MustEnrol) {
        SecondFactorEnrolment(address, "", then, enrolment: next.Enrolment);
      } else if (next.Challenge != "") {
        SecondFactorCodeStep(next.Challenge, then);
      } else {
        // It names the address, and says this step CONFIRMS it: read as a second sign-in step, a code that never came
        // looks like a broken sign-in rather than a mailbox to check (measured 2026-10-13, an operator on an address
        // with no mailbox).
        Alert($"Check your mail at {address}.", title: "Confirm your email address", tone: Tone.Default);
        Text("The mail says what comes next — a six-digit code to type here, or a link to open. Either one confirms that the address is yours; this is not a second sign-in step.",
             color: Colors.TextMuted);
        if (undelivered != "") {
          Alert($"{undelivered} No code will arrive there — if the address is wrong, go back and use the right one.",
                title: "The mail did not arrive", tone: Tone.Danger);
        }
        Field("Code from the mail", value: code, placeholder: "123 456", onEnter: Confirm);
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Confirm", onPress: Confirm, tone: Tone.Primary, size: Size.Lg);
        if (resent) { Text("If a new code was due, it is on its way.", color: Colors.TextMuted, fontSize: FontSize.Label); }
        else { Button("Send a new code", onPress: Resend, tone: Tone.Ghost); }
      }
    }
  }
}

/// Ask for a reset link. Says the same whether or not the address has an account.
[Composable]
public component ForgotPasswordForm() {
  string email = "";
  bool sent = false;

  action Submit() { RequestPasswordReset(email); sent = true; }

  render {
    Stack(gap: 3) {
      if (sent) {
        Alert($"If there is an account for {email}, a link to choose a new password is on its way. It works once, for an hour.",
              tone: Tone.Success);
      } else {
        Field("Email", value: email, type: "email", placeholder: "you@example.com", onEnter: Submit);
        Button("Email me a link", onPress: Submit, tone: Tone.Primary, size: Size.Lg);
      }
      TextLink("Back to sign in", to: "/login", tone: Tone.Default);
    }
  }
}

/// Choose a new password with the token a reset mail carried — and be signed in.
[Composable]
public component ResetPasswordForm(string token) {
  AccountsFacts facts = new AccountsFacts();
  on mount { facts = AccountsPageFacts(); }
  string password = "";
  string again = "";
  string problem = "";
  bool changed = false;

  action Submit() {
    problem = "";
    if (password != again) { problem = "The two passwords are not the same."; return; }
    try {
      var ticket = ResetPassword(token, password);
      // An account with two-step sign-in gets no ticket from a mailed link — it signs in with the new password and a code.
      if (ticket == "") { changed = true; return; }
      Session.SignIn(ticket, facts.HomePath);
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 3) {
      if (changed) {
        Alert("Your password is changed. Sign in with it now — two-step sign-in comes next.", tone: Tone.Success);
        TextLink("Sign in", to: "/login");
      } else {
        Field("New password", value: password, type: "password",
              hint: $"At least {facts.MinPasswordLength} characters.");
        Field("The same again", value: again, type: "password", onEnter: Submit);
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Save and sign in", onPress: Submit, tone: Tone.Primary, size: Size.Lg);
        TextLink("Ask for a new link", to: "/forgot-password", tone: Tone.Default);
      }
    }
  }
}

/// What a verification link opens: it proves the address, and says so — or, on an account's first proof, asks for the
/// password it was made with or a new one (`ConfirmPasswordStep`).
[Composable]
public component VerifyEmailResult(string token) {
  AccountsFacts facts = new AccountsFacts();
  SignInStep step = new SignInStep();
  string problem = "";
  bool done = false;

  on mount {
    facts = AccountsPageFacts();
    try { step = VerifyEmail(token); }
    catch (Exception ex) { problem = ex.Message; }
    done = true;
  }

  render {
    Stack(gap: 3) {
      if (!done) { Text("Confirming…", color: Colors.TextMuted); }
      else if (problem == "" && step.MustConfirmPassword) {
        ConfirmPasswordStep(token, step.Account, "", facts.HomePath);
      } else if (problem == "" && step.AlreadyProven) {
        Alert($"Your account already uses {step.Account} — nothing more to do.", tone: Tone.Success);
        TextLink("Continue", to: facts.HomePath);
      } else if (problem == "") {
        Alert($"{step.Account} is confirmed.", tone: Tone.Success);
        TextLink("Continue", to: facts.HomePath);
      } else {
        Alert(problem, tone: Tone.Danger);
        TextLink("Sign in", to: "/login");
      }
    }
  }
}

/// What the old address's "This wasn't me — cancel the change" link opens (`CancelAddressChange`): the move is called
/// off as the page opens, and it says so — and that every browser signed in to the account was signed out.
[Composable]
public component CancelAddressChangeResult(string token) {
  string kept = "";
  string problem = "";
  bool done = false;

  on mount {
    try { kept = CancelAddressChange(token); }
    catch (Exception ex) { problem = ex.Message; }
    done = true;
  }

  render {
    Stack(gap: 3) {
      if (!done) { Text("Cancelling…", color: Colors.TextMuted); }
      else if (problem == "") {
        Alert($"The change is cancelled: your account does not move to {kept}.", tone: Tone.Success);
        Text("Every browser signed in to your account was signed out. Whoever asked knows your password, so choose a new one now.");
        TextLink("Choose a new password", to: "/forgot-password");
      } else {
        Alert(problem, tone: Tone.Danger);
        TextLink("Sign in", to: "/login");
      }
    }
  }
}

/// The first proof of an address on an account that already has a password (`SignInStep.MustConfirmPassword`): whoever
/// made the account types the password they chose; whoever did not — or has forgotten it — chooses a new one, and the
/// account becomes theirs with every other way into it closed (SECURITY-INVARIANT accounts-first-proof-claims-the-account).
/// The proof is the link's `token`, or the `address` and the `code` its mail carried.
[Composable]
public component ConfirmPasswordStep(string token, string address, string code, string then) {
  AccountsFacts facts = new AccountsFacts();
  on mount { facts = AccountsPageFacts(); }
  string password = "";
  string fresh = "";
  string again = "";
  string problem = "";
  bool choosing = false;
  SignInStep next = new SignInStep();

  action Finish(string current, string chosen) {
    problem = "";
    try {
      next = token != "" ? VerifyEmail(token, current, chosen) : VerifyEmailCode(address, code, current, chosen);
      if (next.Ticket != "") { Session.SignIn(next.Ticket, then); }
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  action Confirm() { Finish(password, ""); }

  action Choose() {
    if (fresh != again) { problem = "The two passwords are not the same."; return; }
    Finish("", fresh);
  }

  action ChooseInstead() { problem = ""; choosing = true; }

  render {
    Stack(gap: 3) {
      if (next.MustEnrol) {
        SecondFactorEnrolment(address, "", then, enrolment: next.Enrolment);
      } else if (next.Challenge != "") {
        SecondFactorCodeStep(next.Challenge, then);
      } else if (choosing) {
        Text($"Choose a password for {address}. The account becomes yours: any password, two-step sign-in, phone or other sign-in set up on it before is removed.",
             color: Colors.TextMuted);
        Field("New password", value: fresh, type: "password", hint: $"At least {facts.MinPasswordLength} characters.");
        Field("The same again", value: again, type: "password", onEnter: Choose);
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Save and sign in", onPress: Choose, tone: Tone.Primary, size: Size.Lg);
      } else {
        Text($"{address} receives mail, and the account for it was made before that was confirmed. If you made it, type the password you chose.",
             color: Colors.TextMuted);
        Field("Your password", value: password, type: "password", onEnter: Confirm);
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Confirm and sign in", onPress: Confirm, tone: Tone.Primary, size: Size.Lg);
        Button("I did not make this account, or forgot its password", onPress: ChooseInstead, tone: Tone.Ghost);
      }
    }
  }
}

/// A signed-in person's sign-in details, one row each — their address, their password, two-step sign-in, a phone (when
/// the app keeps numbers) and the providers they sign in with: what it is, what it is now, and one button. The button
/// opens a dialog holding only that change; Save then asks, as a second step in the same dialog, for the current
/// password — and, with two-step sign-in on, a code from the app, typed last so it is fresh. Nothing is sent before that,
/// and a wrong password or code keeps what was typed and asks again. See the notes in SignIn.osy and SecondFactor.osy for
/// why every change asks for them.
/// In a test press a row's button, fill the dialog, press Save, then fill "Current password" (and "Code from your app")
/// and press Confirm: `Ui.Click("Change address…"); Ui.Fill("New address", "…"); Ui.Click("Save"); …`.
[Composable]
public component AccountSettings() {
  AccountsFacts facts = new AccountsFacts();
  SecondFactorFacts twoStep = new SecondFactorFacts();
  AddressFacts address = new AddressFacts();
  ProviderFacts providers = new ProviderFacts();
  PhoneFacts phone = new PhoneFacts();
  PasskeysFacts keys = new PasskeysFacts();
  bool passkeys = false;
  on mount {
    facts = AccountsPageFacts(); twoStep = MySecondFactor(); address = MyAddress(); providers = MyProviders(); phone = MyPhone();
    keys = MyPasskeys(); passkeys = Passkey.Supported();
  }
  var me = Session.CurrentUser;

  // The change being made: "" (none), "address", "password", "two-step-on", "recovery-codes", "two-step-off",
  // "phone", "phone-remove", "texted-on", "texted-off", "unlink" (`provider`), "passkey-add", "passkey-rename" and
  // "passkey-remove" (`passkeyId`) or "password-remove". Each opens its dialog.
  string change = "";
  // Where its dialog is: "edit" (the change itself), "confirm" (the password and code), "text" (a code texted to the
  // phone), "enrol" (setting up the app) or "codes" (new recovery codes, shown once).
  string step = "";
  string provider = "";
  // The passkey a rename or a removal is of, and the name a new or renamed one gets.
  string passkeyId = "";
  string passkeyName = "";
  string newEmail = "";
  string newPassword = "";
  string newPhone = "";
  string current = "";
  string code = "";
  string textedCode = "";
  // Which confirm field takes the keyboard as the step opens: the password, or — when it is already typed — the code.
  bool codeFirst = false;
  List<string> codes = [];
  string note = "";
  string problem = "";

  action Open(string which) {
    change = which; problem = ""; note = ""; code = ""; textedCode = "";
    // A change with nothing to edit goes straight to its confirmation.
    step = which == "address" || which == "password" || which == "phone" || which == "passkey-add" || which == "passkey-rename"
      ? "edit" : "confirm";
    codeFirst = false;
  }

  action OpenUnlink(string p) { provider = p; Open("unlink"); }

  action OpenPasskey(string which, PasskeyFacts k) { passkeyId = k.CredentialId; passkeyName = k.Name; Open(which); }

  action Resend() { newEmail = address.Pending; Open("address"); step = "confirm"; }

  // A mistyped address is called off here, rather than waited out: the link already mailed to it then moves nothing.
  action CancelPending() {
    note = ""; problem = "";
    var was = address.Pending;
    try { CancelMyAddressChange(); address = MyAddress(); note = $"The move to {was} is cancelled."; }
    catch (Exception ex) { problem = ex.Message; }
  }

  action Close() {
    change = ""; step = ""; provider = ""; current = ""; code = ""; textedCode = ""; problem = ""; codes = [];
    newEmail = ""; newPassword = ""; newPhone = ""; passkeyId = ""; passkeyName = "";
  }

  action Save() {
    problem = "";
    if (change == "address" && newEmail.Trim() == "") { problem = "Type the address to move to."; return; }
    if (change == "password" && newPassword == "") { problem = "Type the new password."; return; }
    if (change == "phone" && newPhone.Trim() == "") { problem = "Type the number."; return; }
    if (change == "passkey-rename") {
      // A name is not a way in: renaming asks for nothing more.
      try { RenamePasskey(passkeyId, passkeyName); Done("The passkey is renamed."); }
      catch (Exception ex) { problem = ex.Message; }
      return;
    }
    code = "";
    codeFirst = current != "";
    step = "confirm";
  }

  action Back() { problem = ""; code = ""; step = "edit"; }

  // A refusal keeps everything typed — the change, the password — and empties the code, which is spent or stale.
  action Refused(string why) { problem = why; code = ""; codeFirst = current != ""; }

  action Done(string said) {
    twoStep = MySecondFactor(); address = MyAddress(); providers = MyProviders(); phone = MyPhone(); keys = MyPasskeys();
    Close();
    note = said;
  }

  action Confirm() {
    problem = "";
    var who = Session.CurrentUser.Email;
    try {
      if (change == "address") {
        ChangeEmail(who, current, newEmail, code);
        var to = newEmail.Trim().ToLower();
        // A move needs no note: the address row now says where the confirmation went.
        Done(to == address.Email ? $"A new link to confirm {address.Email} is on its way." : "");
      } else if (change == "password") {
        // The session stays signed in: its ticket is still good, and moving the page under the person would lose the note.
        ChangePassword(who, current, newPassword, code);
        Done("Your password is changed.");
      } else if (change == "two-step-on") {
        if (current == "") { Refused("Type your current password."); return; }
        step = "enrol";
      } else if (change == "recovery-codes") {
        codes = NewRecoveryCodes(who, current, code);
        twoStep = MySecondFactor();
        code = ""; current = "";
        step = "codes";
      } else if (change == "two-step-off") {
        DisableSecondFactor(who, current, code);
        twoStep = MySecondFactor();
        // An account that must use it moves to another phone this way: off, then set up again at once.
        if (twoStep.Required) { code = ""; change = "two-step-on"; step = "enrol"; } else { Done("Two-step sign-in is off."); }
      } else if (change == "phone") {
        ProvePhone(who, current, newPhone);
        textedCode = ""; code = ""; step = "text";
      } else if (change == "phone-remove") {
        ProvePhone(who, current, "", "", code);
        Done("Your phone number is removed.");
      } else if (change == "texted-on") {
        SetSmsSecondStep(who, current, true);
        Done("Signing in now asks for a code texted to your phone.");
      } else if (change == "texted-off") {
        SetSmsSecondStep(who, current, false);
        textedCode = ""; step = "text";
      } else if (change == "unlink") {
        UnlinkProvider(who, current, provider, code);
        Done($"{provider} no longer signs in to your account.");
      } else if (change == "passkey-add") {
        AddThePasskey("", "");
      } else if (change == "passkey-remove") {
        RemovePasskey(who, passkeyId, current, code);
        Done($"\"{passkeyName}\" no longer signs in to your account.");
      } else if (change == "password-remove") {
        Refused("Confirm with one of your passkeys — that is what you will sign in with.");
      }
    }
    catch (Exception ex) { Refused(ex.Message); }
  }

  /// "Is it you?" answered by one of the account's passkeys instead of the password (and code) — for the passkey
  /// changes, and the only answer turning password sign-in off takes.
  action ConfirmWithPasskey() {
    problem = "";
    var who = Session.CurrentUser.Email;
    try {
      var start = StartPasskeySignIn();
      var answer = Passkey.Get(start.Options);
      if (answer == "") { return; }
      if (change == "passkey-add") {
        AddThePasskey(start.Token, answer);
      } else if (change == "passkey-remove") {
        RemovePasskey(who, passkeyId, "", "", start.Token, answer);
        Done($"\"{passkeyName}\" no longer signs in to your account.");
      } else if (change == "address") {
        ChangeEmail(who, "", newEmail, "", start.Token, answer);
        var to = newEmail.Trim().ToLower();
        Done(to == address.Email ? $"A new link to confirm {address.Email} is on its way." : "");
      } else if (change == "password-remove") {
        RemovePassword(who, start.Token, answer);
        Done("Password sign-in is off. You sign in with your passkeys.");
      }
    }
    catch (Exception ex) { Refused(ex.Message); }
  }

  /// The two halves of adding a passkey, once it is confirmed it is you — by the password and code, or by a passkey's
  /// `token` and `answer`.
  action AddThePasskey(string token, string answer) {
    var who = Session.CurrentUser.Email;
    var first = AddPasskey(who, token == "" ? current : "", token == "" ? code : "", token, answer);
    var made = Passkey.Create(first.Options);
    if (made == "") { Refused("Nothing was added — the passkey prompt was closed."); return; }
    AddPasskey(who, "", "", "", "", "", first.Token, made, passkeyName);
    Done("Your passkey is added. It signs you in from now on.");
  }

  // The last step of a phone change and of turning texted codes off: the code the phone was sent.
  action ConfirmText() {
    problem = "";
    var who = Session.CurrentUser.Email;
    try {
      if (change == "phone") {
        ProvePhone(who, current, newPhone, textedCode, code);
        Done($"Your number {MyPhone().Number} is confirmed.");
      } else {
        SetSmsSecondStep(who, current, false, textedCode);
        Done("Texted sign-in codes are off.");
      }
    }
    catch (Exception ex) { problem = ex.Message; textedCode = ""; code = ""; }
  }

  action SendNewLink() {
    note = ""; problem = "";
    try { RequestVerification(address.Email); note = $"A new link to confirm {address.Email} is on its way."; }
    catch (Exception ex) { problem = ex.Message; }
  }

  action LinkWith(string p) { Navigation.Open(ProviderSignInAddress(p), sameTab: true); }

  render {
    Stack(gap: 4) {
      if (me != null) {
        if (note != "") { Alert(note, tone: Tone.Success); }
        if (problem != "" && change == "") { Alert(problem, tone: Tone.Danger); }
        Stack(gap: 0) {
          SettingsSection("Address", description: "Where your mail goes, and how you sign in.") {
            Stack(gap: 3, pb: 5) {
            Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
              Text(address.Email != "" ? address.Email : me.Email, fontWeight: FontWeight.Semibold);
              if (address.Proven) { Badge("Confirmed", tone: Tone.Success); } else { Badge("Not confirmed", tone: Tone.Warning); }
            }
            if (address.Pending != "") {
              Text($"Confirmation sent to {address.Pending}", color: Colors.TextMuted);
              Text("Your account moves to it when the link in that mail is opened.", fontSize: FontSize.Caption, color: Colors.TextMuted);
              Row(gap: 2) { Button("Resend", onPress: Resend); Button("Cancel", onPress: CancelPending, tone: Tone.Ghost); }
            } else {
              Row(gap: 2, wrap: Wrapping.Wrap) {
                Button("Change address…", onPress: () => Open("address"));
                if (!address.Proven) { Button("Send a new link", onPress: SendNewLink, tone: Tone.Ghost); }
              }
            }
            }
          }
          SettingsSection("Password", description: "What you sign in with, after your address.") {
            Stack(gap: 3, pb: 5) {
            if (keys.PasswordOff) {
              Row(gap: 2, align: Align.Center) { Badge("Off", tone: Tone.Default); Text("You sign in with your passkeys.", color: Colors.TextMuted); }
              Text("Lost every device with a passkey? \"Forgot your password?\" on the sign-in page mails you a link that sets one again.",
                   fontSize: FontSize.Caption, color: Colors.TextMuted);
            } else {
              Row(gap: 2) { Button("Change password…", onPress: () => Open("password")); }
            }
            }
          }
          SettingsSection("Passkeys", description: "Your phone, your laptop or a security key signs you in — no password, no code.") {
            Stack(gap: 3, pb: 5) {
            if (keys.Passkeys.Count == 0) { Text("No passkeys yet.", color: Colors.TextMuted); }
            foreach (var k in keys.Passkeys) {
              Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
                Stack(gap: 0, grow: 1) {
                  Text(k.Name, fontWeight: FontWeight.Semibold);
                  Text(PasskeyLine(k), fontSize: FontSize.Caption, color: Colors.TextMuted);
                }
                if (k.BackedUp) { Badge("Synced", tone: Tone.Default); }
                Button("Rename…", onPress: () => OpenPasskey("passkey-rename", k), size: Size.Sm, tone: Tone.Ghost);
                Button("Remove…", onPress: () => OpenPasskey("passkey-remove", k), size: Size.Sm, tone: Tone.Ghost);
              }
            }
            Row(gap: 2, wrap: Wrapping.Wrap) {
              if (passkeys) { Button("Add a passkey…", onPress: () => Open("passkey-add")); }
              if (passkeys && keys.Passkeys.Count > 0 && !keys.PasswordOff) {
                Button("Turn off password sign-in…", onPress: () => Open("password-remove"), tone: Tone.Ghost);
              }
            }
            if (!passkeys) { Text("This browser cannot make passkeys.", fontSize: FontSize.Caption, color: Colors.TextMuted); }
            }
          }
          SettingsSection("Two-step sign-in", description: "A code from an app on your phone after your password, so a stolen password is not enough.") {
            Stack(gap: 3, pb: 5) {
            Row(gap: 2, align: Align.Center) {
              if (twoStep.On) { Badge("On", tone: Tone.Success); } else { Badge("Off", tone: Tone.Default); }
              if (twoStep.On) { Text($"{twoStep.RecoveryCodesLeft} recovery codes left", color: Colors.TextMuted); }
            }
            // A passkey is both steps at once, so an account the app requires a second step of is not owed one while it has a passkey.
            if (!twoStep.On && twoStep.Required && keys.Passkeys.Count == 0) { Alert($"{facts.AppName} asks for two-step sign-in on your account.", tone: Tone.Warning); }
            Row(gap: 2, wrap: Wrapping.Wrap) {
              if (!twoStep.On) {
                Button("Set up two-step sign-in…", onPress: () => Open("two-step-on"));
              } else {
                Button("New recovery codes…", onPress: () => Open("recovery-codes"));
                Button(twoStep.Required ? "Move to another phone…" : "Turn off two-step sign-in…", onPress: () => Open("two-step-off"),
                       tone: Tone.Ghost);
              }
            }
            }
          }
          if (facts.Phones) {
            SettingsSection("Phone", description: "With its country code. A text proves it is yours.") {
              Stack(gap: 3, pb: 5) {
              Row(gap: 2, align: Align.Center) {
                if (phone.Number != "" && phone.Proven) {
                  Text(phone.Number, fontWeight: FontWeight.Semibold);
                  Badge("Confirmed", tone: Tone.Success);
                } else { Text("No number", color: Colors.TextMuted); }
              }
              if (phone.SecondStep) { Text("Signing in asks for a code texted to this number.", color: Colors.TextMuted); }
              Row(gap: 2, wrap: Wrapping.Wrap) {
                Button(phone.Proven ? "Change number…" : "Add a number…", onPress: () => Open("phone"));
                if (phone.Proven && !phone.SecondStep) { Button("Remove the number…", onPress: () => Open("phone-remove"), tone: Tone.Ghost); }
                if (facts.SmsSecondStep && phone.Proven && !twoStep.On) {
                  if (phone.SecondStep) { Button("Turn off texted codes…", onPress: () => Open("texted-off"), tone: Tone.Ghost); }
                  else { Button("Text me a code when I sign in…", onPress: () => Open("texted-on"), tone: Tone.Ghost); }
                }
              }
              }
            }
          }
          if (providers.Offered.Count > 0) {
            SettingsSection("Sign in with", description: "Another account that signs you in here.") {
              Stack(gap: 3, pb: 5) {
              foreach (var p in providers.Offered) {
                Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
                  Text(p, grow: 1);
                  if (providers.Linked.Contains(p)) {
                    Badge("Linked", tone: Tone.Success);
                    Button("Unlink…", onPress: () => OpenUnlink(p), size: Size.Sm);
                  } else {
                    Button($"Link {p}", onPress: () => LinkWith(p), size: Size.Sm) { Icon(MarkOf(providers.Marks, p), size: 14); }
                  }
                }
              }
              }
            }
          }
        }
        if (change != "") {
          Dialog(ChangeTitle(change, provider, phone.Proven), onDismiss: Close) {
            Stack(gap: 3) {
              if (step == "edit" && change == "address") {
                Field("New address", value: newEmail, type: "email", onEnter: Save,
                      hint: "We mail it a link; your account moves to it when the link is opened.");
              } else if (step == "edit" && change == "password") {
                Field("New password", value: newPassword, type: "password", onEnter: Save,
                      hint: $"At least {facts.MinPasswordLength} characters.");
              } else if (step == "edit" && (change == "passkey-add" || change == "passkey-rename")) {
                Field("Name", value: passkeyName, placeholder: "MacBook, iPhone, YubiKey", onEnter: Save,
                      hint: change == "passkey-add" ? "So you can tell your passkeys apart. Your device asks you to confirm next." : "");
              } else if (step == "edit" && change == "phone") {
                Field("Phone number", value: newPhone, type: "tel", placeholder: "+46 70 123 45 67", onEnter: Save,
                      hint: "With its country code. We text it a code to confirm it is yours.");
              } else if (step == "confirm") {
                Text(ConfirmLine(change, newEmail, newPhone, provider), color: Colors.TextMuted);
                if (change == "password-remove" || (keys.PasswordOff && IsPasskeyChange(change))) {
                  // Nothing to type: one of the account's passkeys says it is you.
                } else if (twoStep.On && AsksForCode(change)) {
                  Field("Current password", value: current, type: "password", autoFocus: !codeFirst);
                  Field("Code from your app", value: code, placeholder: "123 456", autoFocus: codeFirst, onEnter: Confirm,
                        hint: "Type it last, so it is fresh. A recovery code works as well.");
                } else {
                  Field("Current password", value: current, type: "password", autoFocus: true, onEnter: Confirm);
                }
              } else if (step == "text") {
                Text(change == "phone" ? $"We texted a code to {newPhone}." : "We texted a code to your number.", color: Colors.TextMuted);
                if (twoStep.On && change == "phone") {
                  Field("Code from the text", value: textedCode, placeholder: "123 456", autoFocus: true);
                  Field("Code from your app", value: code, placeholder: "123 456", onEnter: ConfirmText,
                        hint: "Type it last, so it is fresh. A recovery code works as well.");
                } else {
                  Field("Code from the text", value: textedCode, placeholder: "123 456", autoFocus: true, onEnter: ConfirmText);
                }
              } else if (step == "enrol") {
                SecondFactorEnrolment(me.Email, current, "/account");
              } else if (step == "codes") {
                RecoveryCodeList(codes);
              }
              if (problem != "") { Alert(problem, tone: Tone.Danger); }
            }
            slot actions {
              if (step == "edit") {
                Button("Cancel", onPress: Close, tone: Tone.Ghost);
                Button("Save", onPress: Save, tone: Tone.Primary);
              } else if (step == "confirm") {
                if (change == "address" || change == "password" || change == "phone") {
                  Button("Back", onPress: Back, tone: Tone.Ghost);
                } else {
                  Button("Cancel", onPress: Close, tone: Tone.Ghost);
                }
                if (IsPasskeyChange(change) && passkeys && keys.Passkeys.Count > 0) {
                  Button(change == "password-remove" || keys.PasswordOff ? "Confirm with a passkey" : "Use a passkey instead",
                         onPress: ConfirmWithPasskey, tone: change == "password-remove" || keys.PasswordOff ? Tone.Primary : Tone.Default);
                }
                if (change != "password-remove" && !(keys.PasswordOff && IsPasskeyChange(change))) {
                  Button(change == "phone" || change == "texted-off" ? "Text me a code" : "Confirm", onPress: Confirm, tone: Tone.Primary);
                }
              } else if (step == "text") {
                Button("Cancel", onPress: Close, tone: Tone.Ghost);
                Button("Confirm", onPress: ConfirmText, tone: Tone.Primary);
              } else if (step == "codes") {
                Button("I have saved them", onPress: () => Done(""), tone: Tone.Primary);
              } else {
                Button("Cancel", onPress: Close, tone: Tone.Ghost);
              }
            }
          }
        }
      }
    }
  }
}

/// The title of the account page's dialog for `change`.
string ChangeTitle(string change, string provider, bool hasPhone) {
  if (change == "address") { return "Change address"; }
  if (change == "password") { return "Change password"; }
  if (change == "two-step-on") { return "Set up two-step sign-in"; }
  if (change == "recovery-codes") { return "New recovery codes"; }
  if (change == "two-step-off") { return "Turn off two-step sign-in"; }
  if (change == "phone") { return hasPhone ? "Change number" : "Add a number"; }
  if (change == "phone-remove") { return "Remove the number"; }
  if (change == "texted-on") { return "Texted sign-in codes"; }
  if (change == "texted-off") { return "Turn off texted codes"; }
  if (change == "passkey-add") { return "Add a passkey"; }
  if (change == "passkey-rename") { return "Rename the passkey"; }
  if (change == "passkey-remove") { return "Remove the passkey"; }
  if (change == "password-remove") { return "Turn off password sign-in"; }
  return $"Unlink {provider}";
}

/// What the confirmation step says it confirms.
string ConfirmLine(string change, string newEmail, string newPhone, string provider) {
  if (change == "address") { return $"To move your account to {newEmail.Trim()}, confirm it is you."; }
  if (change == "password") { return "To save your new password, confirm it is you."; }
  if (change == "two-step-on") { return "To set up two-step sign-in, confirm it is you."; }
  if (change == "recovery-codes") { return "New codes replace the ones you have. Confirm it is you."; }
  if (change == "two-step-off") { return "To turn off two-step sign-in, confirm it is you."; }
  if (change == "phone") { return $"To add {newPhone.Trim()}, confirm it is you — then we text it a code."; }
  if (change == "phone-remove") { return "To remove your number, confirm it is you."; }
  if (change == "texted-on") { return "Signing in will ask for a code texted to your phone. Confirm it is you."; }
  if (change == "texted-off") { return "To turn texted codes off, confirm it is you — then we text you a code."; }
  if (change == "passkey-add") { return "To add a passkey, confirm it is you — then your device makes it."; }
  if (change == "passkey-remove") { return "To remove this passkey, confirm it is you."; }
  if (change == "password-remove") {
    return "Your password is removed, and you sign in with your passkeys. Confirm with one of them — it proves it works.";
  }
  return $"To stop {provider} signing you in, confirm it is you.";
}

/// Does confirming `change` ask for a code from the app (with two-step sign-in on)? A phone change asks for it at its
/// last step, with the texted code; setting up two-step sign-in and texted codes happen only while it is off.
bool AsksForCode(string change) {
  return change == "address" || change == "password" || change == "recovery-codes" || change == "two-step-off"
         || change == "phone-remove" || change == "unlink" || change == "passkey-add" || change == "passkey-remove";
}

/// Is `change` one a passkey may confirm in place of the password? The address is one: it is how an account with
/// password sign-in off is recovered, so that account must be able to move it.
bool IsPasskeyChange(string change) {
  return change == "passkey-add" || change == "passkey-remove" || change == "password-remove" || change == "address";
}

/// When a passkey was added, and when it last signed in.
string PasskeyLine(PasskeyFacts k) {
  var added = k.CreatedAt.ToString("d MMM yyyy");
  if (k.LastUsedAt == null) { return $"Added {added}"; }
  var used = k.LastUsedAt.Value.ToString("d MMM yyyy");
  return $"Added {added} · last used {used}";
}

/// The code step of a sign-in: the authenticator app's six digits (or a recovery code) for `challenge`, then signed in
/// to `then`. "Start again" goes back to the sign-in page.
[Composable]
public component SecondFactorCodeStep(string challenge, string then) {
  string code = "";
  string problem = "";
  bool spent = false;

  action SubmitCode() {
    problem = "";
    try {
      var ticket = SignInWithCode(challenge, code);
      if (ticket == "") { problem = "That code is not right — type the newest one your app shows."; code = ""; return; }
      Session.SignIn(ticket, then);
    }
    catch (Exception ex) { problem = ex.Message; spent = true; }
  }

  render {
    Stack(gap: 3) {
      if (!spent) {
        Text("Open your authenticator app and type the six-digit code it shows for this account.", color: Colors.TextMuted);
        Field("Code", value: code, placeholder: "123 456", onEnter: SubmitCode,
              hint: "Lost your phone? Type one of your recovery codes instead.");
      }
      if (problem != "") { Alert(problem, tone: Tone.Danger); }
      if (!spent) { Button("Continue", onPress: SubmitCode, tone: Tone.Primary, size: Size.Lg); }
      TextLink("Start again", to: "/login", tone: Tone.Default);
    }
  }
}

/// Where a provider sign-in lands (`/oauth/sign-in`): the platform hands the page a sealed token in its address, and
/// this finishes the sign-in with it — a code next, setting two-step sign-in up, or straight in. For a person already
/// signed in it LINKS the provider to their account instead, after their password (and a code, with two-step sign-in on).
/// `then` is where to go afterwards; the account page when linking. `ownDoor`: when the provider verified somebody with
/// no account here and the app is closed to sign-up (`NoAccount`), show the SLOT — the app's own way in, an application
/// form say, which reads the same `pending_oauth` token from the address — instead of saying there is no account.
[Composable]
public component ProviderSignIn(string then = "", bool ownDoor = false) {
  AccountsFacts facts = new AccountsFacts();
  live var pendingToken = Text.Split(Navigation.Hash, "pending_oauth=").Count > 1
    ? Text.Split(Navigation.Hash, "pending_oauth=")[1]
    : "";
  var me = Session.CurrentUser;
  ProviderIdentity who = new ProviderIdentity();
  SignInStep step = new SignInStep();
  string problem = "";
  bool done = false;
  bool noAccount = false;
  string password = "";
  string code = "";
  bool linked = false;

  on mount {
    facts = AccountsPageFacts();
    who = ProviderIdentityOf(pendingToken);
    if (me == null) {
      try {
        step = SignInWithProvider(pendingToken);
        if (step.Ticket != "") { Session.SignIn(step.Ticket, then != "" ? then : facts.HomePath); }
        else if (step.NoAccount || step.OwnDoor) { noAccount = true; }
        else if (!step.MustEnrol && step.Challenge == "") { problem = "That sign-in did not match an account that may sign in here."; }
      }
      catch (Exception ex) { problem = ex.Message; }
    }
    done = true;
  }

  action Link() {
    problem = "";
    try {
      LinkProvider(Session.CurrentUser.Email, password, pendingToken, code);
      linked = true; password = ""; code = "";
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 3) {
      if (!done) { Text("Signing you in…", color: Colors.TextMuted); }
      else if (me != null) {
        if (linked) {
          Alert($"{who.Provider} now signs in to your account.", tone: Tone.Success);
          TextLink("Back to your account", to: "/account");
        } else {
          Text($"Link the {who.Provider} account {who.Email} to your account, {me.Email}, so it signs you in from now on.");
          Field("Current password", value: password, type: "password", onEnter: Link);
          Field("Code from your app", value: code, placeholder: "123 456",
                hint: "Only when two-step sign-in is on — a recovery code works as well.");
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Button($"Link {who.Provider}", onPress: Link, tone: Tone.Primary, size: Size.Lg);
          TextLink("Back to your account", to: "/account", tone: Tone.Default);
        }
      }
      else if (step.MustEnrol) {
        Alert($"{facts.AppName} asks for two-step sign-in on your account. Set it up now — it takes a minute.", tone: Tone.Default);
        SecondFactorEnrolment(step.Account, "", then != "" ? then : facts.HomePath, enrolment: step.Enrolment);
      }
      else if (step.Challenge != "") { SecondFactorCodeStep(step.Challenge, then != "" ? then : facts.HomePath); }
      else if (noAccount && ownDoor) { Slot; }
      else if (noAccount) {
        Alert($"There is no account for {step.Account} here, and {facts.AppName} is not open for sign-up. Ask the person who runs it for an account.",
              tone: Tone.Default);
        TextLink("Back to sign in", to: "/login");
      }
      else if (problem != "") {
        Alert(problem, tone: Tone.Danger);
        TextLink("Back to sign in", to: "/login");
      }
    }
  }
}

/// A QR code's rows (`Qr.Encode`) drawn as modules, labelled for an authenticator app. Kept for apps written against
/// 1.1, which offered it; new code writes Osysharp.Ui's `QrCode(rows, label: …)`, which this now draws.
[Composable]
public component AccountsQrCode(List<string> rows, int module = 4) {
  render { QrCode(rows, module: module, label: "QR code for your authenticator app"); }
}

/// A row of QR modules as its runs, left to right: a dark run's length positive, a light one's negative. Kept for apps
/// written against 1.1, which offered it.
List<int> QrRuns(string row) {
  List<int> runs = [];
  var i = 0;
  while (i < row.Length) {
    var c = row.Substring(i, 1);
    var j = i;
    while (j < row.Length && row.Substring(j, 1) == c) { j = j + 1; }
    runs.Add(c == "1" ? j - i : i - j);
    i = j;
  }
  return runs;
}
